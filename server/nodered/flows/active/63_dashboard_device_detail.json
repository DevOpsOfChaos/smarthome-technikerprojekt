[
  {
    "id": "ui_template_dashboard_detail_v1",
    "type": "ui-template",
    "z": "tab_dashboard_v1_ui",
    "group": "cfg_ui_group_detail_v1",
    "name": "Device Detail View",
    "order": 1,
    "width": 12,
    "height": 0,
    "format": "<template>\n  <div class=\"sh-page\">\n    <div class=\"sh-toolbar\">\n      <div>\n        <h2>Gerätedetail</h2>\n        <p class=\"sh-muted\">Echter Live-Stand aus den aktuellen Servertabellen.</p>\n      </div>\n      <div class=\"sh-toolbar-actions\">\n        <a class=\"sh-btn\" href=\"/dashboard/\">Zur Übersicht</a>\n        <button class=\"sh-btn\" @click=\"reload\">Neu laden</button>\n        <button class=\"sh-theme-btn\" @click=\"toggleTheme\" :title=\"isLight ? 'Zum Dark Mode wechseln' : 'Zum Light Mode wechseln'\" :aria-label=\"isLight ? 'Zum Dark Mode wechseln' : 'Zum Light Mode wechseln'\">\n          <i :class=\"isLight ? 'mdi mdi-weather-night' : 'mdi mdi-white-balance-sunny'\"></i>\n        </button>\n      </div>\n    </div>\n\n    <div v-if=\"commandError\" class=\"sh-alert sh-alert-error\">{{ commandError }}</div>\n    <div v-if=\"commandInfo\" class=\"sh-alert sh-alert-info\">{{ commandInfo }}</div>\n\n    <div class=\"sh-empty\" v-if=\"!detail.device\">Kein Gerät ausgewählt oder noch nicht in `devices` vorhanden.</div>\n\n    <div v-else class=\"sh-detail-shell\">\n      <section class=\"sh-panel sh-panel--primary\" :class=\"detail.device.surface_class\">\n        <div class=\"sh-card-head\">\n          <div>\n            <span class=\"sh-kicker\"><i :class=\"'mdi ' + detail.device.type_icon\"></i>{{ detail.device.kind_label }}</span>\n            <h3>{{ detail.device.display_name }}</h3>\n            <p class=\"sh-muted sh-id\">{{ detail.device.device_id }}</p>\n          </div>\n          <div class=\"sh-chip-stack\">\n            <span class=\"sh-chip\" :class=\"detail.device.availability_class\">{{ detail.device.availability_label }}</span>\n            <span class=\"sh-chip sh-chip-sim\" v-if=\"detail.device.simulation\">SIM</span>\n          </div>\n        </div>\n\n        <div class=\"sh-relay-hero\" v-if=\"isLampDevice(detail.device)\">\n          <div class=\"sh-relay-highlight-column\" v-if=\"lampHighlightsLeft(detail.device).length\">\n            <div class=\"sh-highlight\" v-for=\"item in lampHighlightsLeft(detail.device)\" :key=\"'detail-highlight-left-' + item.key\">\n              <span>{{ item.label }}</span>\n              <strong>{{ item.value_text }}</strong>\n            </div>\n          </div>\n          <button\n            type=\"button\"\n            class=\"sh-lamp-surface\"\n            :class=\"{ 'is-on': detail.device.controls.relay_1_value === true }\"\n            :disabled=\"commandPending\"\n            @click=\"toggleLamp(detail.device)\">\n            <span class=\"sh-lamp-icon\">\n              <i :class=\"detail.device.controls.relay_1_value === true ? 'mdi mdi-lightbulb-on' : 'mdi mdi-lightbulb-outline'\"></i>\n            </span>\n            <span class=\"sh-lamp-copy\">\n              <strong>Lampe {{ relayStateLabel(detail.device) }}</strong>\n            </span>\n          </button>\n          <div class=\"sh-relay-highlight-column\" v-if=\"lampHighlightsRight(detail.device).length\">\n            <div class=\"sh-highlight\" v-for=\"item in lampHighlightsRight(detail.device)\" :key=\"'detail-highlight-right-' + item.key\">\n              <span>{{ item.label }}</span>\n              <strong>{{ item.value_text }}</strong>\n            </div>\n          </div>\n        </div>\n\n        <div class=\"sh-highlight-grid\" v-else-if=\"detail.device.highlight_values && detail.device.highlight_values.length\">\n          <div class=\"sh-highlight\" v-for=\"item in detail.device.highlight_values\" :key=\"'detail-highlight-' + item.key\">\n            <span>{{ item.label }}</span>\n            <strong>{{ item.value_text }}</strong>\n          </div>\n        </div>\n\n        <div class=\"sh-section\" v-if=\"detail.device.controls && detail.device.controls.kind === 'relay' && !isLampDevice(detail.device)\">\n          <h4>Aktoren</h4>\n          <div class=\"sh-inline-row\">\n            <span class=\"sh-secondary-pill\" v-for=\"relay in detail.device.controls.relays\" :key=\"relay.key\">{{ relay.label }}: {{ relay.state_label }}</span>\n          </div>\n        </div>\n\n        <div class=\"sh-section\" v-if=\"detail.device.controls && detail.device.controls.kind === 'cover'\">\n          <h4>Rollladenbedienung</h4>\n          <div class=\"sh-cover-box\">\n            <div class=\"sh-cover-control-shell\">\n              <div class=\"sh-cover-window\">\n                <div class=\"sh-cover-glass\"></div>\n                <div v-if=\"detail.device.controls.position_known\" class=\"sh-cover-shutter\" :class=\"detail.device.controls.motion_class\" :style=\"detail.device.controls.shutter_style\"></div>\n                <div v-else class=\"sh-cover-shutter sh-cover-shutter--unknown\" :class=\"detail.device.controls.motion_class\"></div>\n              </div>\n\n              <div class=\"sh-cover-status-grid\">\n                <div class=\"sh-cover-status-card\">\n                  <span>Position</span>\n                  <strong>{{ detail.device.controls.position_text }}</strong>\n                </div>\n                <div class=\"sh-cover-status-card\">\n                  <span>Bewegung</span>\n                  <strong>{{ detail.device.controls.state_text }}</strong>\n                </div>\n                <div class=\"sh-cover-status-card\">\n                  <span>Status</span>\n                  <strong>{{ detail.device.controls.position_calibrated ? 'Kalibriert' : 'Nicht kalibriert' }}</strong>\n                </div>\n              </div>\n\n              <div class=\"sh-cover-command-row\">\n                <button class=\"sh-btn sh-btn-wide\" :disabled=\"commandPending\" @click=\"sendCoverCommand('open')\">Auf</button>\n                <button class=\"sh-btn sh-btn-wide\" :disabled=\"commandPending\" @click=\"sendCoverCommand('stop')\">Stop</button>\n                <button class=\"sh-btn sh-btn-wide\" :disabled=\"commandPending\" @click=\"sendCoverCommand('close')\">Ab</button>\n              </div>\n\n              <div class=\"sh-cover-position-row\">\n                <input\n                  class=\"sh-cover-slider\"\n                  type=\"range\"\n                  min=\"0\"\n                  max=\"100\"\n                  step=\"1\"\n                  :value=\"positionInput\"\n                  :disabled=\"!canAdjustIntermediate(detail.device.controls) || commandPending\"\n                  @input=\"updatePositionInput\"\n                  @change=\"submitTypedPosition\">\n                <input\n                  class=\"sh-number-input\"\n                  type=\"number\"\n                  min=\"0\"\n                  max=\"100\"\n                  step=\"1\"\n                  :value=\"positionInput\"\n                  :disabled=\"!canAdjustIntermediate(detail.device.controls) || commandPending\"\n                  @input=\"updatePositionInput\"\n                  @change=\"submitTypedPosition\">\n                <button class=\"sh-btn sh-btn-compact\" :disabled=\"!canAdjustIntermediate(detail.device.controls) || commandPending\" @click=\"submitTypedPosition\">Fahren</button>\n              </div>\n              <p class=\"sh-cover-calibration\" v-if=\"detail.device.controls.calibration_hint_text\">{{ detail.device.controls.calibration_hint_text }}</p>\n\n              <div class=\"sh-quick-grid\">\n                <button\n                  v-for=\"quickPosition in quickPositions\"\n                  :key=\"'quick-' + quickPosition\"\n                  type=\"button\"\n                  class=\"sh-quick-btn\"\n                  :disabled=\"isQuickPositionDisabled(detail.device.controls, quickPosition)\"\n                  @click=\"sendQuickPosition(quickPosition)\">\n                  {{ quickPosition }}\n                </button>\n              </div>\n            </div>\n          </div>\n        </div>\n      </section>\n\n      <section class=\"sh-panel sh-panel--compact sh-identity-box\">\n        <h4>Name im Dashboard</h4>\n        <div class=\"sh-state-list\">\n          <div class=\"sh-state-row\">\n            <span>Device-ID</span>\n            <strong>{{ detail.device.device_id }}</strong>\n          </div>\n        </div>\n        <div class=\"sh-name-form\">\n          <label class=\"sh-name-label\" for=\"display-name-input\">Anzeigename</label>\n          <input\n            id=\"display-name-input\"\n            class=\"sh-name-input\"\n            type=\"text\"\n            maxlength=\"80\"\n            placeholder=\"Anzeigenamen setzen\"\n            :value=\"displayNameInput\"\n            :disabled=\"namePending\"\n            @input=\"updateDisplayNameInput\"\n            @keydown.enter.prevent=\"saveDisplayName\">\n          <div class=\"sh-name-actions\">\n            <button class=\"sh-btn sh-btn-compact\" :disabled=\"namePending\" @click=\"saveDisplayName\">Speichern</button>\n            <button class=\"sh-btn sh-btn-compact sh-btn-muted\" :disabled=\"namePending || !detail.device.has_custom_name\" @click=\"resetDisplayName\">Standard</button>\n          </div>\n        </div>\n      </section>\n\n      <section class=\"sh-panel sh-panel--compact\">\n        <h4>Status</h4>\n        <div class=\"sh-state-list\" v-if=\"detail.state_rows && detail.state_rows.length\">\n          <div class=\"sh-state-row\" v-for=\"row in detail.state_rows\" :key=\"row.key\">\n            <span>{{ row.label }}</span>\n            <strong>{{ row.value_text }}</strong>\n          </div>\n        </div>\n        <p class=\"sh-muted\" v-else>Noch keine State-Felder gespeichert.</p>\n      </section>\n\n      <section class=\"sh-panel sh-panel--compact\">\n        <h4>Technik</h4>\n        <div class=\"sh-state-list\">\n          <div class=\"sh-state-row\" v-for=\"row in detail.technical_rows\" :key=\"row.label\">\n            <span>{{ row.label }}</span>\n            <strong>{{ row.value_text }}</strong>\n          </div>\n        </div>\n      </section>\n\n      <section class=\"sh-panel sh-panel--compact sh-raw-panel\">\n        <div class=\"sh-panel-title-row\">\n          <div>\n            <h4>Rohdaten</h4>\n            <p class=\"sh-muted\">Nur fuer Diagnose und Fehlersuche.</p>\n          </div>\n          <button class=\"sh-btn sh-btn-compact\" type=\"button\" @click=\"rawOpen = !rawOpen\">\n            {{ rawOpen ? 'Rohdaten ausblenden' : 'Rohdaten anzeigen' }}\n          </button>\n        </div>\n        <div class=\"sh-raw-stack\" v-if=\"rawOpen\">\n          <div class=\"sh-raw-block\" v-for=\"section in detail.raw_sections\" :key=\"section.key\">\n            <strong>{{ section.label }}</strong>\n            <pre class=\"sh-code-block\">{{ section.value_text }}</pre>\n          </div>\n        </div>\n      </section>\n    </div>\n  </div>\n</template>\n<script>\nexport default {\n  data() {\n    return {\n      isLight: false,\n      currentDeviceId: '',\n      positionInput: '0',\n      displayNameInput: '',\n      commandPending: false,\n      namePending: false,\n      commandError: '',\n      commandInfo: '',\n      quickPositions: [0, 25, 50, 75, 100],\n      displayNameDirty: false,\n      rawOpen: false,\n      autoRefreshTimer: null,\n      autoRefreshMs: 5000\n    }\n  },\n  computed: {\n    detail() { return this.msg?.payload || { device: null, technical_rows: [], state_rows: [], raw_sections: [] } }\n  },\n  watch: {\n    detail: {\n      deep: true,\n      handler() {\n        this.syncPositionInputFromDetail()\n        this.syncDisplayNameFromDetail()\n      }\n    }\n  },\n  methods: {\n    resolveDeviceId() {\n      const url = new URL(window.location.href)\n      return url.searchParams.get('device') || this.currentDeviceId || ''\n    },\n    reload() {\n      const deviceId = this.resolveDeviceId()\n      this.currentDeviceId = deviceId\n      this.send({ payload: { action: 'load', device_id: deviceId } })\n    },\n    loadTheme() {\n      const stored = localStorage.getItem('sh-theme')\n      this.isLight = stored === 'light'\n      this.applyTheme()\n    },\n    toggleTheme() {\n      this.isLight = !this.isLight\n      localStorage.setItem('sh-theme', this.isLight ? 'light' : 'dark')\n      this.applyTheme()\n      window.dispatchEvent(new CustomEvent('sh-theme-change', { detail: { light: this.isLight } }))\n    },\n    applyTheme() {\n      const root = this.$el\n      if (root) {\n        root.classList.toggle('sh-light', this.isLight)\n      }\n      document.body.classList.toggle('sh-light', this.isLight)\n    },\n    onThemeChange(event) {\n      if (event && typeof event.detail === 'object' && 'light' in event.detail) {\n        this.isLight = event.detail.light\n        this.applyTheme()\n      }\n    },\n    loadedDisplayName() {\n      const device = this.detail?.device\n      return device?.has_custom_name ? (device.custom_name || '') : ''\n    },\n    coverInputFocused() {\n      const activeElement = document.activeElement\n      return activeElement?.classList?.contains('sh-cover-slider') || activeElement?.classList?.contains('sh-number-input')\n    },\n    shouldSkipAutoRefresh() {\n      return document.hidden || this.commandPending || this.namePending || this.displayNameDirty || this.coverInputFocused()\n    },\n    startAutoRefresh() {\n      this.stopAutoRefresh()\n\n      // Lokale Geräteaktionen schreiben ihren Status in dieselben Servertabellen. Ohne neuen Load bleibt das im Detail nur optisch stehen.\n      // Der aktuelle Server bekommt hier bewusst nur ein ruhiges Nachziehen des bestehenden Detail-Loads und keine größere Push-/Socket-Architektur.\n      this.autoRefreshTimer = window.setInterval(() => {\n        if (this.shouldSkipAutoRefresh()) {\n          return\n        }\n        this.reload()\n      }, this.autoRefreshMs)\n    },\n    stopAutoRefresh() {\n      if (this.autoRefreshTimer) {\n        window.clearInterval(this.autoRefreshTimer)\n        this.autoRefreshTimer = null\n      }\n    },\n    handleVisibilityChange() {\n      if (!this.shouldSkipAutoRefresh()) {\n        this.reload()\n      }\n    },\n    syncPositionInputFromDetail() {\n      const controls = this.detail?.device?.controls\n      if (!controls || controls.kind !== 'cover' || this.commandPending || this.coverInputFocused()) {\n        return\n      }\n      this.positionInput = String(controls.position_known ? controls.position_value : 0)\n    },\n    syncDisplayNameFromDetail() {\n      const device = this.detail?.device\n      if (!device || this.namePending || this.displayNameDirty) {\n        return\n      }\n      this.displayNameInput = this.loadedDisplayName()\n    },\n    isLampDevice(device) {\n      return Boolean(device?.controls?.allow_overview_toggle)\n    },\n    lampHighlightsLeft(device) {\n      const items = Array.isArray(device?.highlight_values) ? device.highlight_values : []\n      const midpoint = Math.ceil(items.length / 2)\n      return items.slice(0, midpoint)\n    },\n    lampHighlightsRight(device) {\n      const items = Array.isArray(device?.highlight_values) ? device.highlight_values : []\n      const midpoint = Math.ceil(items.length / 2)\n      return items.slice(midpoint)\n    },\n    relayStateLabel(device) {\n      return device?.controls?.relay_1_value === true ? 'An' : 'Aus'\n    },\n    canAdjustIntermediate(controls) {\n      return Boolean(controls?.allow_intermediate_positions)\n    },\n    canSendPosition(controls, position) {\n      if (this.commandPending) {\n        return false\n      }\n      if (position === 0 || position === 100) {\n        // 0 % und 100 % bleiben auch ohne Kalibrierung direkt bedienbar. Nur Zwischenwerte hängen an echter Positionskalibrierung.\n        return Boolean(controls?.allow_end_positions)\n      }\n      return this.canAdjustIntermediate(controls)\n    },\n    isQuickPositionDisabled(controls, position) {\n      return !this.canSendPosition(controls, position)\n    },\n    updateDisplayNameInput(event) {\n      this.displayNameInput = event?.target?.value || ''\n      this.displayNameDirty = this.displayNameInput !== this.loadedDisplayName()\n    },\n    normalizePositionInput(value) {\n      const numericValue = Number(value)\n      if (!Number.isFinite(numericValue)) {\n        return ''\n      }\n      return String(Math.max(0, Math.min(100, Math.round(numericValue))))\n    },\n    updatePositionInput(event) {\n      this.positionInput = this.normalizePositionInput(event?.target?.value)\n    },\n    parsePositionInput() {\n      if (this.positionInput === '') {\n        return null\n      }\n      const numericValue = Number(this.positionInput)\n      if (!Number.isInteger(numericValue) || numericValue < 0 || numericValue > 100) {\n        return null\n      }\n      return numericValue\n    },\n    async postJson(url, payload) {\n      const response = await fetch(url, {\n        method: 'POST',\n        headers: { 'Content-Type': 'application/json' },\n        body: JSON.stringify(payload)\n      })\n      const body = await response.json().catch(() => null)\n      if (!response.ok) {\n        throw new Error(body?.message || body?.error || `HTTP ${response.status}`)\n      }\n      return body\n    },\n    async toggleLamp(device) {\n      if (!this.isLampDevice(device) || this.commandPending) {\n        return\n      }\n\n      this.commandPending = true\n      this.commandError = ''\n      this.commandInfo = ''\n\n      try {\n        const nextRelayValue = !(device.controls.relay_1_value === true)\n        await this.postJson(device.controls.command_url || '/api/phase1/net-erl/relay-1', {\n          device_id: device.device_id,\n          relay_1: nextRelayValue\n        })\n        this.commandInfo = `Lampe ${nextRelayValue ? 'eingeschaltet' : 'ausgeschaltet'}.`\n        window.setTimeout(() => this.reload(), 250)\n      } catch (error) {\n        this.commandError = error?.message || 'Lampenbefehl fehlgeschlagen.'\n      } finally {\n        this.commandPending = false\n      }\n    },\n    async saveDisplayName() {\n      const deviceId = this.detail?.device?.device_id\n      if (!deviceId || this.namePending) {\n        return\n      }\n\n      this.namePending = true\n      this.commandError = ''\n      this.commandInfo = ''\n\n      try {\n        const response = await this.postJson('/api/phase1/dashboard/display-name', {\n          device_id: deviceId,\n          display_name: this.displayNameInput\n        })\n        this.displayNameInput = response?.display_name || ''\n        this.displayNameDirty = false\n        this.commandInfo = response?.display_name ? 'Anzeigename gespeichert.' : 'Anzeigename auf Device-ID zurückgesetzt.'\n        window.setTimeout(() => this.reload(), 180)\n      } catch (error) {\n        this.commandError = error?.message || 'Anzeigename konnte nicht gespeichert werden.'\n      } finally {\n        this.namePending = false\n      }\n    },\n    async resetDisplayName() {\n      this.displayNameInput = ''\n      await this.saveDisplayName()\n    },\n    async sendCoverCommand(command, extraPayload = {}) {\n      const controls = this.detail?.device?.controls\n      const deviceId = this.detail?.device?.device_id\n      if (!controls || controls.kind !== 'cover' || !deviceId || this.commandPending) {\n        return\n      }\n\n      this.commandPending = true\n      this.commandError = ''\n      this.commandInfo = ''\n\n      try {\n        // Die Detailseite hängt absichtlich direkt am vorhandenen engen Cover-Command-Pfad und baut keine zweite Backend-Logik daneben auf.\n        const response = await this.postJson(controls.command_url || '/api/phase1/cover/command', Object.assign({\n          device_id: deviceId,\n          command,\n          cover_calibrated: Boolean(controls.position_calibrated),\n          is_calibrated: Boolean(controls.position_calibrated)\n        }, extraPayload))\n        this.commandInfo = this.describeAcceptedCommand(response)\n        window.setTimeout(() => this.reload(), 300)\n      } catch (error) {\n        this.commandError = error?.message || 'Rollladenbefehl fehlgeschlagen.'\n      } finally {\n        this.commandPending = false\n      }\n    },\n    describeAcceptedCommand(response) {\n      const command = response?.command || ''\n      if (command === 'set_position') {\n        return `Fahrt zu ${response.position} % angenommen.`\n      }\n      if (command === 'open') {\n        return 'Auf-Befehl angenommen.'\n      }\n      if (command === 'close') {\n        return 'Ab-Befehl angenommen.'\n      }\n      if (command === 'stop') {\n        return 'Stop-Befehl angenommen.'\n      }\n      return 'Befehl angenommen.'\n    },\n    async submitTypedPosition() {\n      const controls = this.detail?.device?.controls\n      if (!controls || !this.canAdjustIntermediate(controls)) {\n        return\n      }\n      const position = this.parsePositionInput()\n      if (position === null) {\n        this.commandError = 'Position muss als ganze Zahl zwischen 0 und 100 vorliegen.'\n        return\n      }\n      await this.sendPositionCommand(position)\n    },\n    async sendPositionCommand(position) {\n      const controls = this.detail?.device?.controls\n      if (!controls || this.commandPending) {\n        return\n      }\n\n      if ((position === 0 || position === 100) && !Boolean(controls.allow_end_positions)) {\n        return\n      }\n\n      // Ohne Kalibrierung bleiben nur 0 und 100 aktiv. So blockiert die UI Zwischenwerte bewusst, lässt die sicheren Endlagen aber weiter durch.\n      if (position !== 0 && position !== 100 && !this.canAdjustIntermediate(controls)) {\n        this.commandError = 'Zwischenpositionen sind ohne Kalibrierung gesperrt.'\n        return\n      }\n\n      this.positionInput = String(position)\n      await this.sendCoverCommand('set_position', { position })\n    },\n    async sendQuickPosition(position) {\n      const controls = this.detail?.device?.controls\n      if (!controls || this.isQuickPositionDisabled(controls, position)) {\n        return\n      }\n      await this.sendPositionCommand(position)\n    }\n  },\n  mounted() {\n    setTimeout(() => this.reload(), 120)\n    this.startAutoRefresh()\n    this.loadTheme()\n    window.addEventListener('sh-theme-change', this.onThemeChange)\n    document.addEventListener('visibilitychange', this.handleVisibilityChange)\n  },\n  unmounted() {\n    this.stopAutoRefresh()\n    window.removeEventListener('sh-theme-change', this.onThemeChange)\n    document.removeEventListener('visibilitychange', this.handleVisibilityChange)\n  }\n}\n</script>\n<style>\n\n  .sh-page{--sh-border:#2a3846;--sh-text:#ecf3fa;--sh-muted:#9db0c3;--sh-chip:#182432;color:var(--sh-text);padding:.35rem 0 .6rem;width:100%;max-width:100%;overflow-x:hidden}.sh-page *{box-sizing:border-box;min-width:0}.sh-toolbar,.sh-toolbar-actions,.sh-chip-stack,.sh-inline-row{display:flex;gap:.45rem;flex-wrap:wrap}.sh-toolbar{justify-content:space-between;align-items:flex-start;margin-bottom:.8rem}.sh-toolbar>*{max-width:100%}.sh-toolbar h2,.sh-panel h3,.sh-panel h4{margin:0;overflow-wrap:anywhere}.sh-muted{color:var(--sh-muted);margin:.15rem 0 0;overflow-wrap:anywhere}.sh-btn{display:inline-flex;align-items:center;justify-content:center;min-height:44px;border:1px solid var(--sh-border);border-radius:999px;background:linear-gradient(180deg,rgba(22,33,45,.96),rgba(10,17,25,.98));color:var(--sh-text);padding:.62rem .95rem;cursor:pointer;text-decoration:none;touch-action:manipulation}.sh-btn:disabled,.sh-quick-btn:disabled,.sh-cover-slider:disabled,.sh-number-input:disabled,.sh-name-input:disabled{cursor:not-allowed;opacity:.55}.sh-btn-wide{flex:1 1 0;min-width:5.2rem}.sh-btn-compact{padding:.58rem .82rem}.sh-btn-muted{background:linear-gradient(180deg,rgba(46,56,67,.96),rgba(21,27,33,.98));border-color:rgba(96,112,126,.56)}.sh-chip,.sh-secondary-pill{display:inline-flex;align-items:center;gap:.25rem;max-width:100%;border-radius:999px;border:1px solid transparent;background:var(--sh-chip);color:var(--sh-text);padding:.3rem .6rem;font-size:.82rem;overflow-wrap:anywhere}.sh-chip{flex:0 0 auto;white-space:nowrap;overflow-wrap:normal}.sh-secondary-pill{background:rgba(24,36,50,.88);border-color:rgba(61,83,105,.72)}.sh-secondary-pill.is-state-ready{border-color:rgba(84,184,129,.42);color:#b6f1cb}.sh-secondary-pill.is-state-limited{border-color:rgba(204,152,76,.42);color:#ffd897}.sh-chip-online{background:rgba(21,78,53,.82);color:#9af3c2;border-color:rgba(86,185,129,.3)}.sh-chip-late{background:rgba(77,64,23,.88);color:#ffdd8b;border-color:rgba(177,145,63,.3)}.sh-chip-offline{background:rgba(86,28,38,.86);color:#ffb5bf;border-color:rgba(185,89,105,.28)}.sh-chip-unknown{background:#232e39;color:#b6c2cc}.sh-chip-sim{background:rgba(66,50,19,.88);color:#ffd98a}.sh-alert{border-radius:14px;padding:.65rem .8rem;margin-bottom:.75rem;overflow-wrap:anywhere}.sh-alert-error{background:rgba(96,28,40,.86);border:1px solid rgba(198,92,110,.34);color:#ffd1d7}.sh-alert-info{background:rgba(19,60,86,.88);border:1px solid rgba(97,163,214,.34);color:#d0ecff}.sh-empty,.sh-panel{border:1px solid var(--sh-border);border-radius:18px;background:linear-gradient(180deg,rgba(18,27,38,.97),rgba(11,18,25,.99));padding:.9rem 1rem;overflow:hidden}.sh-detail-shell{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,22rem),1fr));gap:.8rem;align-items:start;justify-items:stretch;width:100%;max-width:100%}.sh-panel{width:100%;max-width:none}.sh-panel--primary{grid-column:1/-1;width:100%;max-width:none}.sh-panel.is-relay-card{border-color:rgba(171,139,67,.55)}.sh-panel.is-cover-card{border-color:rgba(99,168,207,.55)}.sh-panel.is-battery-card{border-color:rgba(75,143,89,.55)}.sh-card-head{display:flex;justify-content:space-between;gap:.7rem;align-items:flex-start;margin-bottom:.7rem}.sh-card-head>div:first-child{min-width:0;flex:1 1 auto}.sh-chip-stack{justify-content:flex-end;flex:0 0 auto}.sh-kicker{display:inline-flex;align-items:center;gap:.35rem;font-size:.78rem;text-transform:uppercase;let