[
  {
    "id": "ui_template_dashboard_detail_v1",
    "type": "ui-template",
    "z": "tab_dashboard_v1_ui",
    "group": "cfg_ui_group_detail_v1",
    "name": "Device Detail View",
    "order": 1,
    "width": 12,
    "height": 0,
    "format": "<template>\n  <div class=\"sh-page\">\n    <div class=\"sh-toolbar\">\n      <div>\n        <h2>Gerätedetail</h2>\n        <p class=\"sh-muted\">Echter Live-Stand aus den aktuellen Phase-1-Tabellen.</p>\n      </div>\n      <div class=\"sh-toolbar-actions\">\n        <a class=\"sh-btn\" href=\"/dashboard/\">Zur Übersicht</a>\n        <button class=\"sh-btn\" @click=\"reload\">Neu laden</button>\n      </div>\n    </div>\n\n    <div v-if=\"commandError\" class=\"sh-alert sh-alert-error\">{{ commandError }}</div>\n    <div v-if=\"commandInfo\" class=\"sh-alert sh-alert-info\">{{ commandInfo }}</div>\n\n    <div class=\"sh-empty\" v-if=\"!detail.device\">Kein Gerät ausgewählt oder noch nicht in `devices` vorhanden.</div>\n\n    <div v-else class=\"sh-detail-shell\">\n      <section class=\"sh-panel\" :class=\"detail.device.surface_class\">\n        <div class=\"sh-card-head\">\n          <div>\n            <span class=\"sh-kicker\"><i :class=\"'mdi ' + detail.device.type_icon\"></i>{{ detail.device.kind_label }}</span>\n            <h3>{{ detail.device.display_name }}</h3>\n            <p class=\"sh-muted sh-id\">{{ detail.device.device_id }}</p>\n          </div>\n          <div class=\"sh-chip-stack\">\n            <span class=\"sh-chip\" :class=\"detail.device.availability_class\">{{ detail.device.availability_label }}</span>\n            <span class=\"sh-chip sh-chip-sim\" v-if=\"detail.device.simulation\">SIM</span>\n          </div>\n        </div>\n\n        <div class=\"sh-highlight-grid\" v-if=\"detail.device.highlight_values && detail.device.highlight_values.length\">\n          <div class=\"sh-highlight\" v-for=\"item in detail.device.highlight_values\" :key=\"'detail-highlight-' + item.key\">\n            <span>{{ item.label }}</span>\n            <strong>{{ item.value_text }}</strong>\n          </div>\n        </div>\n\n        <div class=\"sh-section\" v-if=\"detail.device.controls && detail.device.controls.kind === 'relay'\">\n          <h4>Aktoren</h4>\n          <div class=\"sh-inline-row\">\n            <span class=\"sh-secondary-pill\" v-for=\"relay in detail.device.controls.relays\" :key=\"relay.key\">{{ relay.label }}: {{ relay.state_label }}</span>\n          </div>\n          <p class=\"sh-muted\">Die direkte Schnellbedienung bleibt im Overview nur auf `net_erl` begrenzt.</p>\n        </div>\n\n        <div class=\"sh-section\" v-if=\"detail.device.controls && detail.device.controls.kind === 'cover'\">\n          <h4>Rollladenbedienung</h4>\n          <div class=\"sh-cover-box\">\n            <div class=\"sh-cover-window\">\n              <div class=\"sh-cover-glass\"></div>\n              <div v-if=\"detail.device.controls.position_known\" class=\"sh-cover-shutter\" :class=\"detail.device.controls.motion_class\" :style=\"detail.device.controls.shutter_style\"></div>\n              <div v-else class=\"sh-cover-shutter sh-cover-shutter--unknown\" :class=\"detail.device.controls.motion_class\"></div>\n            </div>\n\n            <div class=\"sh-inline-row\">\n              <span class=\"sh-secondary-pill\">Position: {{ detail.device.controls.position_text }}</span>\n              <span class=\"sh-secondary-pill\">{{ detail.device.controls.state_text }}</span>\n              <span class=\"sh-secondary-pill\" :class=\"detail.device.controls.position_calibrated ? 'is-state-ready' : 'is-state-limited'\">\n                {{ detail.device.controls.position_calibrated ? 'Kalibriert' : 'Nicht kalibriert' }}\n              </span>\n            </div>\n\n            <div class=\"sh-cover-command-row\">\n              <button class=\"sh-btn sh-btn-wide\" :disabled=\"commandPending\" @click=\"sendCoverCommand('open')\">Auf</button>\n              <button class=\"sh-btn sh-btn-wide\" :disabled=\"commandPending\" @click=\"sendCoverCommand('stop')\">Stop</button>\n              <button class=\"sh-btn sh-btn-wide\" :disabled=\"commandPending\" @click=\"sendCoverCommand('close')\">Ab</button>\n            </div>\n\n            <div class=\"sh-cover-position-row\">\n              <input\n                class=\"sh-cover-slider\"\n                type=\"range\"\n                min=\"0\"\n                max=\"100\"\n                step=\"1\"\n                :value=\"positionInput\"\n                :disabled=\"!canAdjustIntermediate(detail.device.controls) || commandPending\"\n                @input=\"updatePositionInput\"\n                @change=\"submitTypedPosition\">\n              <input\n                class=\"sh-number-input\"\n                type=\"number\"\n                min=\"0\"\n                max=\"100\"\n                step=\"1\"\n                :value=\"positionInput\"\n                :disabled=\"!canAdjustIntermediate(detail.device.controls) || commandPending\"\n                @input=\"updatePositionInput\"\n                @change=\"submitTypedPosition\">\n              <button class=\"sh-btn sh-btn-compact\" :disabled=\"!canAdjustIntermediate(detail.device.controls) || commandPending\" @click=\"submitTypedPosition\">Fahren</button>\n            </div>\n\n            <div class=\"sh-quick-grid\">\n              <button\n                v-for=\"quickPosition in quickPositions\"\n                :key=\"'quick-' + quickPosition\"\n                type=\"button\"\n                class=\"sh-quick-btn\"\n                :disabled=\"isQuickPositionDisabled(detail.device.controls, quickPosition)\"\n                @click=\"sendQuickPosition(quickPosition)\">\n                {{ quickPosition }}\n              </button>\n            </div>\n\n            <p class=\"sh-muted\" v-if=\"!canAdjustIntermediate(detail.device.controls)\">\n              Zwischenpositionen bleiben bewusst gesperrt. Ohne saubere Kalibrierung sind nur die Endlagen 0 % und 100 % belastbar.\n            </p>\n            <p class=\"sh-muted\" v-else>\n              Slider, Zahleneingabe und Quick-Buttons senden direkt über den vorhandenen Cover-Command-Pfad.\n            </p>\n          </div>\n        </div>\n\n        <div class=\"sh-section\">\n          <h4>Status</h4>\n          <div class=\"sh-state-list\" v-if=\"detail.state_rows && detail.state_rows.length\">\n            <div class=\"sh-state-row\" v-for=\"row in detail.state_rows\" :key=\"row.key\">\n              <span>{{ row.label }}</span>\n              <strong>{{ row.value_text }}</strong>\n            </div>\n          </div>\n          <p class=\"sh-muted\" v-else>Noch keine State-Felder gespeichert.</p>\n        </div>\n      </section>\n\n      <section class=\"sh-panel\">\n        <h4>Technik</h4>\n        <div class=\"sh-state-list\">\n          <div class=\"sh-state-row\" v-for=\"row in detail.technical_rows\" :key=\"row.label\">\n            <span>{{ row.label }}</span>\n            <strong>{{ row.value_text }}</strong>\n          </div>\n        </div>\n      </section>\n\n      <section class=\"sh-panel\">\n        <h4>Rohdaten</h4>\n        <div class=\"sh-raw-stack\">\n          <div class=\"sh-raw-block\" v-for=\"section in detail.raw_sections\" :key=\"section.key\">\n            <strong>{{ section.label }}</strong>\n            <pre class=\"sh-code-block\">{{ section.value_text }}</pre>\n          </div>\n        </div>\n      </section>\n    </div>\n  </div>\n</template>\n<script>\nexport default {\n  data() {\n    return {\n      currentDeviceId: '',\n      positionInput: '0',\n      commandPending: false,\n      commandError: '',\n      commandInfo: '',\n      quickPositions: [0, 25, 50, 75, 100]\n    }\n  },\n  computed: {\n    detail() { return this.msg?.payload || { device: null, technical_rows: [], state_rows: [], raw_sections: [] } }\n  },\n  watch: {\n    detail: {\n      deep: true,\n      handler() {\n        this.syncPositionInputFromDetail()\n      }\n    }\n  },\n  methods: {\n    resolveDeviceId() {\n      const url = new URL(window.location.href)\n      return url.searchParams.get('device') || this.currentDeviceId || ''\n    },\n    reload() {\n      const deviceId = this.resolveDeviceId()\n      this.currentDeviceId = deviceId\n      this.send({ payload: { action: 'load', device_id: deviceId } })\n    },\n    syncPositionInputFromDetail() {\n      const controls = this.detail?.device?.controls\n      if (!controls || controls.kind !== 'cover' || this.commandPending) {\n        return\n      }\n      this.positionInput = String(controls.position_known ? controls.position_value : 0)\n    },\n    canAdjustIntermediate(controls) {\n      return Boolean(controls?.allow_intermediate_positions)\n    },\n    canSendPosition(controls, position) {\n      if (this.commandPending) {\n        return false\n      }\n      if (position === 0 || position === 100) {\n        // 0 % und 100 % bleiben auch ohne Kalibrierung direkt bedienbar. Nur Zwischenwerte hängen an echter Positionskalibrierung.\n        return Boolean(controls?.allow_end_positions)\n      }\n      return this.canAdjustIntermediate(controls)\n    },\n    isQuickPositionDisabled(controls, position) {\n      return !this.canSendPosition(controls, position)\n    },\n    normalizePositionInput(value) {\n      const numericValue = Number(value)\n      if (!Number.isFinite(numericValue)) {\n        return ''\n      }\n      return String(Math.max(0, Math.min(100, Math.round(numericValue))))\n    },\n    updatePositionInput(event) {\n      this.positionInput = this.normalizePositionInput(event?.target?.value)\n    },\n    parsePositionInput() {\n      if (this.positionInput === '') {\n        return null\n      }\n      const numericValue = Number(this.positionInput)\n      if (!Number.isInteger(numericValue) || numericValue < 0 || numericValue > 100) {\n        return null\n      }\n      return numericValue\n    },\n    async postJson(url, payload) {\n      const response = await fetch(url, {\n        method: 'POST',\n        headers: { 'Content-Type': 'application/json' },\n        body: JSON.stringify(payload)\n      })\n      const body = await response.json().catch(() => null)\n      if (!response.ok) {\n        throw new Error(body?.message || body?.error || `HTTP ${response.status}`)\n      }\n      return body\n    },\n    async sendCoverCommand(command, extraPayload = {}) {\n      const controls = this.detail?.device?.controls\n      const deviceId = this.detail?.device?.device_id\n      if (!controls || controls.kind !== 'cover' || !deviceId || this.commandPending) {\n        return\n      }\n\n      this.commandPending = true\n      this.commandError = ''\n      this.commandInfo = ''\n\n      try {\n        // Die Detailseite hängt absichtlich direkt am vorhandenen engen Cover-Command-Pfad und baut keine zweite Backend-Logik daneben auf.\n        const response = await this.postJson(controls.command_url || '/api/phase1/cover/command', Object.assign({\n          device_id: deviceId,\n          command,\n          cover_calibrated: Boolean(controls.position_calibrated),\n          is_calibrated: Boolean(controls.position_calibrated)\n        }, extraPayload))\n        this.commandInfo = this.describeAcceptedCommand(response)\n        window.setTimeout(() => this.reload(), 300)\n      } catch (error) {\n        this.commandError = error?.message || 'Rollladenbefehl fehlgeschlagen.'\n      } finally {\n        this.commandPending = false\n      }\n    },\n    describeAcceptedCommand(response) {\n      const command = response?.command || ''\n      if (command === 'set_position') {\n        return `Fahrt zu ${response.position} % angenommen.`\n      }\n      if (command === 'open') {\n        return 'Auf-Befehl angenommen.'\n      }\n      if (command === 'close') {\n        return 'Ab-Befehl angenommen.'\n      }\n      if (command === 'stop') {\n        return 'Stop-Befehl angenommen.'\n      }\n      return 'Befehl angenommen.'\n    },\n    async submitTypedPosition() {\n      const controls = this.detail?.device?.controls\n      if (!controls || !this.canAdjustIntermediate(controls)) {\n        return\n      }\n      const position = this.parsePositionInput()\n      if (position === null) {\n        this.commandError = 'Position muss als ganze Zahl zwischen 0 und 100 vorliegen.'\n        return\n      }\n      await this.sendPositionCommand(position)\n    },\n    async sendPositionCommand(position) {\n      const controls = this.detail?.device?.controls\n      if (!controls || this.commandPending) {\n        return\n      }\n\n      if ((position === 0 || position === 100) && !Boolean(controls.allow_end_positions)) {\n        return\n      }\n\n      // Ohne Kalibrierung bleiben nur 0 und 100 aktiv. So blockiert die UI Zwischenwerte bewusst, lässt die sicheren Endlagen aber weiter durch.\n      if (position !== 0 && position !== 100 && !this.canAdjustIntermediate(controls)) {\n        this.commandError = 'Zwischenpositionen sind ohne Kalibrierung gesperrt.'\n        return\n      }\n\n      this.positionInput = String(position)\n      await this.sendCoverCommand('set_position', { position })\n    },\n    async sendQuickPosition(position) {\n      const controls = this.detail?.device?.controls\n      if (!controls || this.isQuickPositionDisabled(controls, position)) {\n        return\n      }\n      await this.sendPositionCommand(position)\n    }\n  },\n  mounted() {\n    setTimeout(() => this.reload(), 120)\n  }\n}\n</script>\n<style>\n  .sh-page{--sh-border:#2a3846;--sh-text:#ecf3fa;--sh-muted:#9db0c3;--sh-chip:#182432;color:var(--sh-text);padding:.35rem 0 .6rem}.sh-page *{box-sizing:border-box}.sh-toolbar,.sh-toolbar-actions,.sh-chip-stack,.sh-inline-row{display:flex;gap:.45rem;flex-wrap:wrap}.sh-toolbar{justify-content:space-between;align-items:flex-start;margin-bottom:.8rem}.sh-toolbar h2,.sh-panel h3,.sh-panel h4{margin:0}.sh-muted{color:var(--sh-muted);margin:.15rem 0 0}.sh-btn{border:1px solid var(--sh-border);border-radius:999px;background:linear-gradient(180deg,rgba(22,33,45,.96),rgba(10,17,25,.98));color:var(--sh-text);padding:.55rem .9rem;cursor:pointer;text-decoration:none}.sh-btn:disabled,.sh-quick-btn:disabled,.sh-cover-slider:disabled,.sh-number-input:disabled{cursor:not-allowed;opacity:.55}.sh-btn-wide{flex:1 1 0;min-width:5.2rem}.sh-btn-compact{padding:.55rem .8rem}.sh-chip,.sh-secondary-pill{display:inline-flex;align-items:center;gap:.25rem;border-radius:999px;border:1px solid transparent;background:var(--sh-chip);color:var(--sh-text);padding:.3rem .6rem;font-size:.82rem}.sh-secondary-pill{background:rgba(24,36,50,.88);border-color:rgba(61,83,105,.72)}.sh-secondary-pill.is-state-ready{border-color:rgba(84,184,129,.42);color:#b6f1cb}.sh-secondary-pill.is-state-limited{border-color:rgba(204,152,76,.42);color:#ffd897}.sh-chip-online{background:rgba(21,78,53,.82);color:#9af3c2;border-color:rgba(86,185,129,.3)}.sh-chip-late{background:rgba(77,64,23,.88);color:#ffdd8b;border-color:rgba(177,145,63,.3)}.sh-chip-offline{background:rgba(86,28,38,.86);color:#ffb5bf;border-color:rgba(185,89,105,.28)}.sh-chip-unknown{background:#232e39;color:#b6c2cc}.sh-chip-sim{background:rgba(66,50,19,.88);color:#ffd98a}.sh-alert{border-radius:14px;padding:.65rem .8rem;margin-bottom:.75rem}.sh-alert-error{background:rgba(96,28,40,.86);border:1px solid rgba(198,92,110,.34);color:#ffd1d7}.sh-alert-info{background:rgba(19,60,86,.88);border:1px solid rgba(97,163,214,.34);color:#d0ecff}.sh-empty,.sh-panel{border:1px solid var(--sh-border);border-radius:18px;background:linear-gradient(180deg,rgba(18,27,38,.97),rgba(11,18,25,.99));padding:.9rem 1rem}.sh-detail-shell{display:grid;gap:.8rem}.sh-panel.is-relay-card{border-color:rgba(171,139,67,.55)}.sh-panel.is-cover-card{border-color:rgba(99,168,207,.55)}.sh-panel.is-battery-card{border-color:rgba(75,143,89,.55)}.sh-card-head{display:flex;justify-content:space-between;gap:.7rem;align-items:flex-start;margin-bottom:.7rem}.sh-kicker{display:inline-flex;align-items:center;gap:.35rem;font-size:.78rem;text-transform:uppercase;letter-spacing:.08em;color:#a8c4de;margin-bottom:.2rem}.sh-id{font-size:.8rem}.sh-highlight-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(110px,1fr));gap:.42rem}.sh-highlight{border:1px solid rgba(45,65,84,.8);border-radius:14px;padding:.5rem .55rem;background:rgba(9,16,23,.45)}.sh-highlight span{display:block;font-size:.72rem;color:var(--sh-muted);margin-bottom:.12rem}.sh-highlight strong{font-size:.96rem}.sh-section{margin-top:1rem}.sh-section h4{margin-bottom:.45rem}.sh-state-list{display:grid;gap:.25rem}.sh-state-row{display:flex;justify-content:space-between;gap:.7rem;border-bottom:1px solid rgba(31,45,58,.9);padding-bottom:.28rem}.sh-cover-box{display:grid;gap:.75rem}.sh-cover-window{position:relative;width:min(100%,10.5rem);aspect-ratio:.92;border-radius:16px 16px 12px 12px;padding:.46rem;background:linear-gradient(180deg,#dbe9f5,#8aa5be 55%,#5c7387);box-shadow:inset 0 0 0 1px rgba(255,255,255,.22);overflow:hidden}.sh-cover-glass{position:absolute;inset:.44rem;border-radius:12px 12px 8px 8px;background:linear-gradient(180deg,rgba(207,230,249,.94),rgba(138,190,228,.82))}.sh-cover-shutter{position:absolute;left:.44rem;right:.44rem;top:.44rem;border-radius:12px 12px 8px 8px;background:linear-gradient(180deg,rgba(238,242,246,.96),rgba(179,191,204,.98))}.sh-cover-shutter--unknown{height:58%;opacity:.86;background:linear-gradient(180deg,rgba(207,212,219,.88),rgba(128,139,149,.94))}.sh-cover-command-row{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.45rem}.sh-cover-position-row{display:grid;grid-template-columns:minmax(0,1fr) 5.5rem auto;gap:.45rem;align-items:center}.sh-cover-slider{width:100%}.sh-number-input{width:100%;border:1px solid rgba(61,83,105,.72);border-radius:12px;background:rgba(10,16,24,.92);color:var(--sh-text);padding:.55rem .65rem}.sh-quick-grid{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:.42rem}.sh-quick-btn{border:1px solid rgba(61,83,105,.72);border-radius:14px;background:rgba(15,24,34,.94);color:var(--sh-text);padding:.6rem .2rem;cursor:pointer}.sh-quick-btn:not(:disabled):hover,.sh-quick-btn:not(:disabled):focus-visible{border-color:rgba(123,200,255,.6);background:rgba(23,38,52,.96)}.sh-raw-stack{display:grid;gap:.7rem}.sh-raw-block{border:1px solid rgba(31,45,58,.9);border-radius:14px;background:rgba(8,12,17,.74);padding:.7rem;display:grid;gap:.45rem}.sh-code-block{margin:0;white-space:pre-wrap;word-break:break-word;font-family:\"Courier New\",Courier,monospace;font-size:.82rem;line-height:1.35}@media (max-width:640px){.sh-toolbar,.sh-card-head,.sh-state-row{flex-direction:column;align-items:flex-start}.sh-cover-command-row,.sh-cover-position-row,.sh-quick-grid{grid-template-columns:1fr}}\n</style>",
    "storeOutMessages": true,
    "passthru": false,
    "resendOnRefresh": true,
