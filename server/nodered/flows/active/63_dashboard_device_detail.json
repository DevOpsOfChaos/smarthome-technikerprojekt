  {
    "id": "fn_build_dashboard_detail_query_v1",
    "type": "function",
    "z": "tab_dashboard_v1_ui",
    "name": "Build Detail Query",
    "func": "const dashboard = global.get(\"dashboardV1\");\nif (!dashboard) {\n    node.error(\"dashboardV1 helper missing\");\n    return null;\n}\nconst request = msg.payload || {};\nconst deviceId = typeof request.device_id === \"string\" ? request.device_id.trim() : \"\";\nif (!deviceId) {\n    msg.payload = dashboard.buildDeviceDetailPayload([]);\n    return msg;\n}\nmsg.topic = dashboard.buildDeviceDetailQuery(deviceId);\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 470,
    "y": 280,
    "wires": [
      [
        "sqlite_dashboard_detail_v1"
      ]
    ]
  },
  {
    "id": "sqlite_dashboard_detail_v1",
    "type": "sqlite",
    "z": "tab_dashboard_v1_ui",
    "mydb": "sqlitedb_30_phase1",
    "sqlquery": "msg.topic",
    "sql": "",
    "name": "Read Detail",
    "x": 680,
