[
  {
    "id": "ui_template_dashboard_detail_v1",
    "type": "ui-template",
    "z": "tab_dashboard_v1_ui",
    "group": "cfg_ui_group_detail_v1",
    "name": "Device Detail View",
    "order": 1,
    "width": 12,
    "height": 0,
    "format": "<template>\n  <div class=\"sh-page\">\n    <div class=\"sh-toolbar\">\n      <div>\n        <h2>Gerätedetail</h2>\n        <p class=\"sh-muted\">Echter Live-Stand aus den aktuellen Phase-1-Tabellen.</p>\n      </div>\n      <div class=\"sh-toolbar-actions\">\n        <a class=\"sh-btn\" href=\"/dashboard/\">Zur Übersicht</a>\n        <button class=\"sh-btn\" @click=\"reload\">Neu laden</button>\n      </div>\n    </div>\n\n    <div class=\"sh-empty\" v-if=\"!detail.device\">Kein Gerät ausgewählt oder noch nicht in `devices` vorhanden.</div>\n\n    <div v-else class=\"sh-detail-shell\">\n      <section class=\"sh-panel\" :class=\"detail.device.surface_class\">\n        <div class=\"sh-card-head\">\n          <div>\n            <span class=\"sh-kicker\"><i :class=\"'mdi ' + detail.device.type_icon\"></i>{{ detail.device.kind_label }}</span>\n            <h3>{{ detail.device.display_name }}</h3>\n            <p class=\"sh-muted sh-id\">{{ detail.device.device_id }}</p>\n          </div>\n          <div class=\"sh-chip-stack\">\n            <span class=\"sh-chip\" :class=\"detail.device.availability_class\">{{ detail.device.availability_label }}</span>\n            <span class=\"sh-chip sh-chip-sim\" v-if=\"detail.device.simulation\">SIM</span>\n          </div>\n        </div>\n\n        <div class=\"sh-highlight-grid\" v-if=\"detail.device.highlight_values && detail.device.highlight_values.length\">\n          <div class=\"sh-highlight\" v-for=\"item in detail.device.highlight_values\" :key=\"'detail-highlight-' + item.key\">\n            <span>{{ item.label }}</span>\n            <strong>{{ item.value_text }}</strong>\n          </div>\n        </div>\n\n        <div class=\"sh-section\" v-if=\"detail.device.controls && detail.device.controls.kind === 'relay'\">\n          <h4>Aktoren</h4>\n          <div class=\"sh-inline-row\">\n            <span class=\"sh-secondary-pill\" v-for=\"relay in detail.device.controls.relays\" :key=\"relay.key\">{{ relay.label }}: {{ relay.state_label }}</span>\n          </div>\n          <p class=\"sh-muted\">Direkte Bedienung ist in diesem engen V1-Schnitt bewusst nicht aktiv.</p>\n        </div>\n\n        <div class=\"sh-section\" v-if=\"detail.device.controls && detail.device.controls.kind === 'cover'\">\n          <h4>Rollladenstatus</h4>\n          <div class=\"sh-cover-box\">\n            <div class=\"sh-cover-window\">\n              <div class=\"sh-cover-glass\"></div>\n              <div v-if=\"detail.device.controls.position_known\" class=\"sh-cover-shutter\" :class=\"detail.device.controls.motion_class\" :style=\"detail.device.controls.shutter_style\"></div>\n              <div v-else class=\"sh-cover-shutter sh-cover-shutter--unknown\" :class=\"detail.device.controls.motion_class\"></div>\n            </div>\n            <div class=\"sh-inline-row\">\n              <span class=\"sh-secondary-pill\">Position: {{ detail.device.controls.position_text }}</span>\n              <span class=\"sh-secondary-pill\">{{ detail.device.controls.state_text }}</span>\n            </div>\n          </div>\n          <p class=\"sh-muted\">`net_zrl` bekommt hier die enge Zusatzlogik, aber ohne Command-Pfad.</p>\n        </div>\n\n        <div class=\"sh-section\">\n          <h4>Status</h4>\n          <div class=\"sh-state-list\" v-if=\"detail.state_rows && detail.state_rows.length\">\n            <div class=\"sh-state-row\" v-for=\"row in detail.state_rows\" :key=\"row.key\">\n              <span>{{ row.label }}</span>\n              <strong>{{ row.value_text }}</strong>\n            </div>\n          </div>\n          <p class=\"sh-muted\" v-else>Noch keine State-Felder gespeichert.</p>\n        </div>\n      </section>\n\n      <section class=\"sh-panel\">\n        <h4>Technik</h4>\n        <div class=\"sh-state-list\">\n          <div class=\"sh-state-row\" v-for=\"row in detail.technical_rows\" :key=\"row.label\">\n            <span>{{ row.label }}</span>\n            <strong>{{ row.value_text }}</strong>\n          </div>\n        </div>\n      </section>\n\n      <section class=\"sh-panel\">\n        <h4>Rohdaten</h4>\n        <div class=\"sh-raw-stack\">\n          <div class=\"sh-raw-block\" v-for=\"section in detail.raw_sections\" :key=\"section.key\">\n            <strong>{{ section.label }}</strong>\n            <pre class=\"sh-code-block\">{{ section.value_text }}</pre>\n          </div>\n        </div>\n      </section>\n    </div>\n  </div>\n</template>\n<script>\nexport default {\n  data() { return { currentDeviceId: '' } },\n  computed: {\n    detail() { return this.msg?.payload || { device: null, technical_rows: [], state_rows: [], raw_sections: [] } }\n  },\n  methods: {\n    resolveDeviceId() {\n      const url = new URL(window.location.href)\n      return url.searchParams.get('device') || this.currentDeviceId || ''\n    },\n    reload() {\n      const deviceId = this.resolveDeviceId()\n      this.currentDeviceId = deviceId\n      this.send({ payload: { action: 'load', device_id: deviceId } })\n    }\n  },\n  mounted() { setTimeout(() => this.reload(), 120) }\n}\n</script>\n<style>\n  .sh-page{--sh-border:#2a3846;--sh-text:#ecf3fa;--sh-muted:#9db0c3;--sh-chip:#182432;color:var(--sh-text);padding:.35rem 0 .6rem}.sh-page *{box-sizing:border-box}.sh-toolbar,.sh-toolbar-actions,.sh-chip-stack,.sh-inline-row{display:flex;gap:.45rem;flex-wrap:wrap}.sh-toolbar{justify-content:space-between;align-items:flex-start;margin-bottom:.8rem}.sh-toolbar h2,.sh-panel h3,.sh-panel h4{margin:0}.sh-muted{color:var(--sh-muted);margin:.15rem 0 0}.sh-btn{border:1px solid var(--sh-border);border-radius:999px;background:linear-gradient(180deg,rgba(22,33,45,.96),rgba(10,17,25,.98));color:var(--sh-text);padding:.55rem .9rem;cursor:pointer;text-decoration:none}.sh-chip,.sh-secondary-pill{display:inline-flex;align-items:center;gap:.25rem;border-radius:999px;border:1px solid transparent;background:var(--sh-chip);color:var(--sh-text);padding:.3rem .6rem;font-size:.82rem}.sh-secondary-pill{background:rgba(24,36,50,.88);border-color:rgba(61,83,105,.72)}.sh-chip-online{background:rgba(21,78,53,.82);color:#9af3c2;border-color:rgba(86,185,129,.3)}.sh-chip-late{background:rgba(77,64,23,.88);color:#ffdd8b;border-color:rgba(177,145,63,.3)}.sh-chip-offline{background:rgba(86,28,38,.86);color:#ffb5bf;border-color:rgba(185,89,105,.28)}.sh-chip-unknown{background:#232e39;color:#b6c2cc}.sh-chip-sim{background:rgba(66,50,19,.88);color:#ffd98a}.sh-empty,.sh-panel{border:1px solid var(--sh-border);border-radius:18px;background:linear-gradient(180deg,rgba(18,27,38,.97),rgba(11,18,25,.99));padding:.9rem 1rem}.sh-detail-shell{display:grid;gap:.8rem}.sh-panel.is-relay-card{border-color:rgba(171,139,67,.55)}.sh-panel.is-cover-card{border-color:rgba(99,168,207,.55)}.sh-panel.is-battery-card{border-color:rgba(75,143,89,.55)}.sh-card-head{display:flex;justify-content:space-between;gap:.7rem;align-items:flex-start;margin-bottom:.7rem}.sh-kicker{display:inline-flex;align-items:center;gap:.35rem;font-size:.78rem;text-transform:uppercase;letter-spacing:.08em;color:#a8c4de;margin-bottom:.2rem}.sh-id{font-size:.8rem}.sh-highlight-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(110px,1fr));gap:.42rem}.sh-highlight{border:1px solid rgba(45,65,84,.8);border-radius:14px;padding:.5rem .55rem;background:rgba(9,16,23,.45)}.sh-highlight span{display:block;font-size:.72rem;color:var(--sh-muted);margin-bottom:.12rem}.sh-highlight strong{font-size:.96rem}.sh-section{margin-top:1rem}.sh-section h4{margin-bottom:.45rem}.sh-state-list{display:grid;gap:.25rem}.sh-state-row{display:flex;justify-content:space-between;gap:.7rem;border-bottom:1px solid rgba(31,45,58,.9);padding-bottom:.28rem}.sh-cover-box{display:grid;gap:.7rem}.sh-cover-window{position:relative;width:min(100%,10.5rem);aspect-ratio:.92;border-radius:16px 16px 12px 12px;padding:.46rem;background:linear-gradient(180deg,#dbe9f5,#8aa5be 55%,#5c7387);box-shadow:inset 0 0 0 1px rgba(255,255,255,.22);overflow:hidden}.sh-cover-glass{position:absolute;inset:.44rem;border-radius:12px 12px 8px 8px;background:linear-gradient(180deg,rgba(207,230,249,.94),rgba(138,190,228,.82))}.sh-cover-shutter{position:absolute;left:.44rem;right:.44rem;top:.44rem;border-radius:12px 12px 8px 8px;background:linear-gradient(180deg,rgba(238,242,246,.96),rgba(179,191,204,.98))}.sh-cover-shutter--unknown{height:58%;opacity:.86;background:linear-gradient(180deg,rgba(207,212,219,.88),rgba(128,139,149,.94))}.sh-raw-stack{display:grid;gap:.7rem}.sh-raw-block{border:1px solid rgba(31,45,58,.9);border-radius:14px;background:rgba(8,12,17,.74);padding:.7rem;display:grid;gap:.45rem}.sh-code-block{margin:0;white-space:pre-wrap;word-break:break-word;font-family:\"Courier New\",Courier,monospace;font-size:.82rem;line-height:1.35}@media (max-width:640px){.sh-toolbar,.sh-card-head,.sh-state-row{flex-direction:column;align-items:flex-start}}\n</style>",
    "storeOutMessages": true,
    "passthru": false,
    "resendOnRefresh": true,
    "templateScope": "local",
    "className": "",
    "x": 220,
    "y": 280,
    "wires": [
      [
        "fn_build_dashboard_detail_query_v1"
      ]
    ]
  },
  {
    "id": "fn_build_dashboard_detail_query_v1",
    "type": "function",
    "z": "tab_dashboard_v1_ui",
    "name": "Build Detail Query",
    "func": "const dashboard = global.get(\"dashboardV1\");\nif (!dashboard) {\n    node.error(\"dashboardV1 helper missing\");\n    return null;\n}\nconst request = msg.payload || {};\nconst deviceId = typeof request.device_id === \"string\" ? request.device_id.trim() : \"\";\nif (!deviceId) {\n    msg.payload = dashboard.buildDeviceDetailPayload([]);\n    return msg;\n}\nmsg.topic = dashboard.buildDeviceDetailQuery(deviceId);\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 470,
    "y": 280,
    "wires": [
      [
        "sqlite_dashboard_detail_v1"
      ]
    ]
  },
  {
    "id": "sqlite_dashboard_detail_v1",
    "type": "sqlite",
    "z": "tab_dashboard_v1_ui",
    "mydb": "cfg_sqlite_db",
    "sqlquery": "msg.topic",
    "sql": "",
    "name": "Read Detail",
    "x": 680,
    "y": 280,
    "wires": [
      [
        "fn_build_dashboard_detail_payload_v1"
      ]
    ]
  },
  {
    "id": "fn_build_dashboard_detail_payload_v1",
    "type": "function",
    "z": "tab_dashboard_v1_ui",
    "name": "Build Detail Payload",
    "func": "const dashboard = global.get(\"dashboardV1\");\nif (!dashboard) {\n    node.error(\"dashboardV1 helper missing\");\n    return null;\n}\nmsg.payload = dashboard.buildDeviceDetailPayload(Array.isArray(msg.payload) ? msg.payload : []);\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
