    "type": "function",
    "z": "tab_dashboard_automations_v1",
    "name": "Aktion dispatchen",
    "func": "// Eingehende Aktionen aus dem Vue-Template an die richtigen Ausgänge weiterleiten.\n// Ausgänge:\n//   0 → list            (Übersicht laden)\n//   1 → save            (Automatisierung speichern/erstellen/bearbeiten)\n//   2 → delete          (Automatisierung löschen)\n//   3 → toggle          (enabled-Flag umschalten)\n//   4 → load_conditions (Bedingungen für Bearbeiten nachladen)\nconst action = msg.payload && msg.payload.action;\n\nif (action === 'list') {\n    return [msg, null, null, null, null];\n}\nif (action === 'save') {\n    return [null, msg, null, null, null];\n}\nif (action === 'delete') {\n    return [null, null, msg, null, null];\n}\nif (action === 'toggle_enabled') {\n    return [null, null, null, msg, null];\n}\nif (action === 'load_conditions') {\n    return [null, null, null, null, msg];\n}\n// Unbekannte Aktion: zur Liste zurückfallen\nreturn [msg, null, null, null, null];",
