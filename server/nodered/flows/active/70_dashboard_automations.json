    "type": "function",
    "z": "tab_dashboard_automations_v1",
    "name": "Bedingungen-Abfrage bauen",
    "func": "// Bedingungen einer bestehenden Automatisierung nachladen.\n// Die Listenansicht enthält nur condition_count; beim Bearbeiten müssen die\n// echten Conditions separat geladen werden, sonst würden sie beim Speichern\n// versehentlich durch eine leere Liste ersetzt.\nconst store = global.get('automationStore');\nif (!store) {\n    node.error('automationStore nicht verfügbar');\n    msg.payload = { error: 'automationStore nicht verfügbar' };\n    return [null, msg];\n}\n\nconst automationId = msg.payload && msg.payload.automation_id;\nconst query = store.buildGetQuery(automationId);\nif (!query.conditionsSql) {\n    msg.payload = { error: 'automation_id fehlt' };\n    return [null, msg];\n}\n\nmsg.topic = query.conditionsSql;\nmsg._automationId = automationId;\nreturn [msg, null];",
