    "name": "Listen-Payload bauen",
    "func": "// SQLite-Rows in ein UI-fertiges Payload für das Vue-Template übersetzen.\nconst rows = Array.isArray(msg.payload) ? msg.payload : [];\nconst automations = rows.map(function(r) {\n    return {\n        automation_id:   r.automation_id,\n        name:            r.name,\n        enabled:         r.enabled === 1 || r.enabled === true,\n        target_device_id: r.target_device_id,\n        action_kind:     r.action_kind,\n        action_payload:  r.action_payload,\n        created_at:      r.created_at,\n        updated_at:      r.updated_at,\n        last_run_at:     r.last_run_at || null,\n        last_result:     r.last_result || null,\n        condition_count: Number(r.condition_count) || 0\n    };\n});\nmsg.payload = { automations: automations };\nreturn msg;",
