  {
    "id": "fn_automations_save_v1",
    "type": "function",
    "z": "tab_dashboard_automations_v1",
    "name": "Automatisierung speichern",
    "func": "// Eingehende Formulardaten validieren und als SQL-Batch speichern.\n// Validierung übernimmt automationStore.validateAutomation + validateCondition.\nconst store = global.get('automationStore');\nif (!store) {\n    node.error('automationStore nicht verfügbar');\n    msg.payload = { error: 'automationStore nicht verfügbar' };\n    return [null, msg];\n}\n\nconst data = msg.payload || {};\nconst automationInput = data.automation || {};\nconst conditionsInput = Array.isArray(data.conditions) ? data.conditions : [];\n\n// Automatisierungs-Record validieren\nconst autoResult = store.validateAutomation(automationInput);\nif (!autoResult.ok) {\n    msg.payload = { error: autoResult.field + ': ' + autoResult.message };\n    return [null, msg];\n}\n\n// Bedingungen validieren (alle oder keine)\nconst condRecords = [];\nfor (let i = 0; i < conditionsInput.length; i++) {\n    const condResult = store.validateCondition(conditionsInput[i], autoResult.record.automation_id);\n    if (!condResult.ok) {\n        msg.payload = { error: 'Bedingung ' + (i + 1) + ' – ' + condResult.field + ': ' + condResult.message };\n        return [null, msg];\n    }\n    condRecords.push(condResult.record);\n}\n\n// SQL-Batch erzeugen (BEGIN IMMEDIATE … COMMIT)\nconst sql = store.buildUpsertStatements(autoResult.record, condRecords);\nif (!sql) {\n    msg.payload = { error: 'SQL-Erzeugung fehlgeschlagen' };\n    return [null, msg];\n}\n\nmsg.topic = sql;\nmsg._automationId = autoResult.record.automation_id;\nreturn [msg, null];",
