[
  {
    "id": "tab_dashboard_automations_v1",
    "type": "tab",
    "label": "70 Dashboard Automatisierungen",
    "disabled": false,
    "info": "Automatisierungsseite: CRUD für Automatisierungsregeln (auflisten, erstellen, bearbeiten, löschen). Persistenz via SQLite (automations + automation_conditions). Commands werden ausschliesslich über commandMinimal erzeugt."
  },
  {
    "id": "ui_template_automations_v1",
    "type": "ui-template",
    "z": "tab_dashboard_automations_v1",
    "group": "cfg_ui_group_automations_v1",
    "name": "Automatisierungen View",
    "order": 1,
    "width": 12,
    "height": 0,
    "format": "<template>\n  <div class=\"sh-page\" :class=\"{ 'sh-light': isLight }\">\n    <div class=\"sh-toolbar\">\n      <div>\n        <h2>Automatisierungen</h2>\n        <p class=\"sh-muted\">CRUD-Verwaltung für zeitbasierte und zustandsbasierte Regeln.</p>\n      </div>\n      <div class=\"sh-toolbar-actions\">\n        <button class=\"sh-btn\" @click=\"openCreate\">+ Neu</button>\n        <button class=\"sh-btn sh-btn-muted\" @click=\"reload\">Neu laden</button>\n        <button class=\"sh-theme-btn\" @click=\"toggleTheme\"><i :class=\"isLight ? 'mdi mdi-weather-night' : 'mdi mdi-white-balance-sunny'\"></i></button>\n      </div>\n    </div>\n\n    <div v-if=\"errorMsg\" class=\"sh-alert sh-alert-error\">{{ errorMsg }}</div>\n    <div v-if=\"infoMsg\" class=\"sh-alert sh-alert-info\">{{ infoMsg }}</div>\n\n    <div v-if=\"view === 'list'\">\n      <div class=\"sh-empty\" v-if=\"!automations.length\">Noch keine Automatisierungen vorhanden. Klicke auf \"+ Neu\" um die erste zu erstellen.</div>\n      <div class=\"sh-auto-list\" v-else>\n        <article v-for=\"a in automations\" :key=\"a.automation_id\" class=\"sh-panel sh-auto-card\">\n          <div class=\"sh-card-head\">\n            <div>\n              <span class=\"sh-kicker\"><i class=\"mdi mdi-cog-play-outline\"></i>{{ kindLabel(a.action_kind) }}</span>\n              <h3>{{ a.name }}</h3>\n              <p class=\"sh-muted sh-id\">Ziel: {{ a.target_device_id }}</p>\n            </div>\n            <div class=\"sh-chip-stack\">\n              <span class=\"sh-chip\" :class=\"a.enabled ? 'sh-chip-online' : 'sh-chip-offline'\">{{ a.enabled ? 'aktiv' : 'inaktiv' }}</span>\n            </div>\n          </div>\n          <div class=\"sh-state-list\">\n            <div class=\"sh-state-row\">\n              <span>Bedingungen</span>\n              <strong>{{ a.condition_count || 0 }}</strong>\n            </div>\n            <div class=\"sh-state-row\" v-if=\"a.last_run_at\">\n              <span>Zuletzt ausgelöst</span>\n              <strong :title=\"a.last_run_at\">{{ formatRelative(a.last_run_at) }}</strong>\n            </div>\n            <div class=\"sh-state-row\" v-if=\"a.last_result\">\n              <span>Letztes Ergebnis</span>\n              <strong :class=\"a.last_result === 'ok' ? 'sh-val-ok' : 'sh-val-warn'\">{{ a.last_result }}</strong>\n            </div>\n          </div>\n          <div class=\"sh-auto-actions\">\n            <button class=\"sh-btn sh-btn-compact\" @click=\"openEdit(a)\">Bearbeiten</button>\n            <button class=\"sh-btn sh-btn-compact sh-btn-muted\" @click=\"toggleEnabled(a)\">{{ a.enabled ? 'Deaktivieren' : 'Aktivieren' }}</button>\n            <button class=\"sh-btn sh-btn-compact sh-btn-danger\" @click=\"confirmDelete(a)\">Löschen</button>\n          </div>\n        </article>\n      </div>\n    </div>\n\n    <div v-if=\"view === 'form'\" class=\"sh-panel sh-form-panel\">\n      <h3>{{ form.automation_id ? 'Automatisierung bearbeiten' : 'Neue Automatisierung' }}</h3>\n\n      <div class=\"sh-form-group\">\n        <label class=\"sh-label\">Name *</label>\n        <input class=\"sh-input\" type=\"text\" v-model=\"form.name\" maxlength=\"120\" placeholder=\"z. B. Rolladen ab bei Sonnenuntergang\">\n      </div>\n\n      <div class=\"sh-form-group\">\n        <label class=\"sh-label\">Zielgerät (target_device_id) *</label>\n        <input class=\"sh-input\" type=\"text\" v-model=\"form.target_device_id\" maxlength=\"80\" placeholder=\"z. B. net_erl_01\">\n      </div>\n\n      <div class=\"sh-form-group\">\n        <label class=\"sh-label\">Aktionstyp *</label>\n        <select class=\"sh-input\" v-model=\"form.action_kind\" @change=\"onActionKindChange\">\n          <option value=\"\">-- Bitte wählen --</option>\n          <option value=\"net_erl_relay_1\">Relais schalten (net_erl relay_1)</option>\n          <option value=\"net_zrl_cover\">Rolladen steuern (net_zrl cover)</option>\n        </select>\n      </div>\n\n      <div class=\"sh-form-group\" v-if=\"form.action_kind === 'net_erl_relay_1'\">\n        <label class=\"sh-label\">Relais-Wert *</label>\n        <select class=\"sh-input\" v-model=\"form.action_relay_1\">\n          <option value=\"true\">Einschalten (relay_1: true)</option>\n          <option value=\"false\">Ausschalten (relay_1: false)</option>\n        </select>\n      </div>\n\n      <div class=\"sh-form-group\" v-if=\"form.action_kind === 'net_zrl_cover'\">\n        <label class=\"sh-label\">Rolladen-Befehl *</label>\n        <select class=\"sh-input\" v-model=\"form.action_cover_command\">\n          <option value=\"open\">Auf (open)</option>\n          <option value=\"close\">Ab (close)</option>\n          <option value=\"stop\">Stop</option>\n        </select>\n      </div>\n\n      <div class=\"sh-form-group\">\n        <label class=\"sh-label\">\n          <input type=\"checkbox\" v-model=\"form.enabled\">&nbsp;Automatisierung aktiviert\n        </label>\n      </div>\n\n      <hr class=\"sh-divider\">\n      <h4>Bedingungen <span class=\"sh-muted\">(alle müssen erfüllt sein – AND-Verknüpfung)</span></h4>\n\n      <div class=\"sh-conditions-list\">\n        <div v-for=\"(cond, idx) in form.conditions\" :key=\"idx\" class=\"sh-condition-block\">\n          <div class=\"sh-condition-head\">\n            <strong>Bedingung {{ idx + 1 }}</strong>\n            <button class=\"sh-btn sh-btn-compact sh-btn-danger\" @click=\"removeCondition(idx)\">Entfernen</button>\n          </div>\n\n          <div class=\"sh-form-row\">\n            <div class=\"sh-form-group\">\n              <label class=\"sh-label\">Scope</label>\n              <select class=\"sh-input\" v-model=\"cond.condition_scope\" @change=\"onCondScopeChange(cond)\">\n                <option value=\"global\">global (Zeit/Wochentag)</option>\n                <option value=\"local\">local (Gerätezustand)</option>\n              </select>\n            </div>\n            <div class=\"sh-form-group\">\n              <label class=\"sh-label\">Art</label>\n              <select class=\"sh-input\" v-model=\"cond.condition_kind\">\n                <template v-if=\"cond.condition_scope === 'global'\">\n                  <option value=\"weekdays\">Wochentage</option>\n                  <option value=\"time_exact\">Exakte Uhrzeit</option>\n                  <option value=\"time_window\">Zeitfenster</option>\n                </template>\n                <template v-else>\n                  <option value=\"device_state\">Gerätezustand</option>\n                </template>\n              </select>\n            </div>\n          </div>\n\n          <div v-if=\"cond.condition_kind === 'weekdays'\">\n            <label class=\"sh-label\">Wochentage (mehrere wählbar)</label>\n            <div class=\"sh-weekday-row\">\n              <label v-for=\"(wd, wi) in weekdayLabels\" :key=\"wi\" class=\"sh-weekday-label\">\n                <input type=\"checkbox\" :value=\"wi\" v-model=\"cond.weekdays_arr\">&nbsp;{{ wd }}\n              </label>\n            </div>\n          </div>\n\n          <div v-if=\"cond.condition_kind === 'time_exact'\">\n            <div class=\"sh-form-group\">\n              <label class=\"sh-label\">Uhrzeit (HH:MM)</label>\n              <input class=\"sh-input\" type=\"time\" v-model=\"cond.time_start\">\n            </div>\n          </div>\n\n          <div v-if=\"cond.condition_kind === 'time_window'\">\n            <div class=\"sh-form-row\">\n              <div class=\"sh-form-group\">\n                <label class=\"sh-label\">Von (HH:MM)</label>\n                <input class=\"sh-input\" type=\"time\" v-model=\"cond.time_start\">\n              </div>\n              <div class=\"sh-form-group\">\n                <label class=\"sh-label\">Bis (HH:MM)</label>\n                <input class=\"sh-input\" type=\"time\" v-model=\"cond.time_end\">\n              </div>\n            </div>\n          </div>\n\n          <div v-if=\"cond.condition_kind === 'device_state'\">\n            <div class=\"sh-form-row\">\n              <div class=\"sh-form-group\">\n                <label class=\"sh-label\">Quellgerät</label>\n                <input class=\"sh-input\" type=\"text\" v-model=\"cond.source_device_id\" placeholder=\"z. B. bat_sen_01\">\n              </div>\n              <div class=\"sh-form-group\">\n                <label class=\"sh-label\">Feld</label>\n                <input class=\"sh-input\" type=\"text\" v-model=\"cond.field_name\" placeholder=\"z. B. motion\">\n              </div>\n            </div>\n            <div class=\"sh-form-row\">\n              <div class=\"sh-form-group\">\n                <label class=\"sh-label\">Operator</label>\n                <select class=\"sh-input\" v-model=\"cond.operator\">\n                  <option value=\"eq\">eq (gleich)</option>\n                  <option value=\"neq\">neq (ungleich)</option>\n                  <option value=\"gt\">gt (größer)</option>\n                  <option value=\"gte\">gte (größer oder gleich)</option>\n                  <option value=\"lt\">lt (kleiner)</option>\n                  <option value=\"lte\">lte (kleiner oder gleich)</option>\n                </select>\n              </div>\n              <div class=\"sh-form-group\">\n                <label class=\"sh-label\">Erwarteter Wert</label>\n                <input class=\"sh-input\" type=\"text\" v-model=\"cond.expected_value\" placeholder=\"z. B. true\">\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      <button class=\"sh-btn sh-btn-muted\" @click=\"addCondition\" style=\"margin-top:.5rem\">+ Bedingung hinzufügen</button>\n\n      <div class=\"sh-form-actions\">\n        <button class=\"sh-btn\" :disabled=\"saving\" @click=\"saveForm\">{{ saving ? 'Speichern…' : 'Speichern' }}</button>\n        <button class=\"sh-btn sh-btn-muted\" @click=\"cancelForm\">Abbrechen</button>\n      </div>\n    </div>\n\n    <div v-if=\"deleteTarget\" class=\"sh-overlay\">\n      <div class=\"sh-modal\">\n        <h3>Automatisierung löschen?</h3>\n        <p>\"{{ deleteTarget.name }}\" wird unwiderruflich gelöscht (inkl. aller Bedingungen).</p>\n        <div class=\"sh-modal-actions\">\n          <button class=\"sh-btn sh-btn-danger\" @click=\"doDelete\">Löschen</button>\n          <button class=\"sh-btn sh-btn-muted\" @click=\"deleteTarget = null\">Abbrechen</button>\n        </div>\n      </div>\n    </div>\n  </div>\n</template>\n<script>\nexport default {\n  data() {\n    return {\n      isLight: false,\n      view: 'list',\n      automations: [],\n      form: this.emptyForm(),\n      saving: false,\n      errorMsg: '',\n      infoMsg: '',\n      deleteTarget: null,\n      weekdayLabels: ['So', 'Mo', 'Di', 'Mi', 'Do', 'Fr', 'Sa']\n    }\n  },\n  computed: {\n    payload() { return this.msg?.payload || {} }\n  },\n  watch: {\n    payload: {\n      deep: true,\n      handler(p) {\n        if (Array.isArray(p.automations)) {\n          this.automations = p.automations\n        }\n        if (p.saved) {\n          this.infoMsg = 'Automatisierung gespeichert.'\n          this.view = 'list'\n          this.saving = false\n          setTimeout(() => { this.infoMsg = '' }, 3000)\n          this.reload()\n        }\n        if (p.deleted) {\n          this.infoMsg = 'Automatisierung gelöscht.'\n          this.deleteTarget = null\n          setTimeout(() => { this.infoMsg = '' }, 3000)\n          this.reload()\n        }\n        if (p.toggled) {\n          this.reload()\n        }\n        if (p.conditions_loaded && p.automation_id === this.form.automation_id) {\n          this.form.conditions = (p.conditions || []).map(c => this.condFromDb(c))\n        }\n        if (p.error) {\n          this.errorMsg = p.error\n          this.saving = false\n          setTimeout(() => { this.errorMsg = '' }, 6000)\n        }\n      }\n    }\n  },\n  methods: {\n    emptyForm() {\n      return {\n        automation_id: '',\n        name: '',\n        target_device_id: '',\n        action_kind: '',\n        action_relay_1: 'true',\n        action_cover_command: 'open',\n        enabled: true,\n        conditions: []\n      }\n    },\n    emptyCondition() {\n      return {\n        condition_scope: 'global',\n        condition_kind: 'weekdays',\n        weekdays_arr: [],\n        time_start: '',\n        time_end: '',\n        source_device_id: '',\n        field_name: '',\n        operator: 'eq',\n        expected_value: ''\n      }\n    },\n    kindLabel(kind) {\n      if (kind === 'net_erl_relay_1') return 'Relais (net_erl)'\n      if (kind === 'net_zrl_cover') return 'Rolladen (net_zrl)'\n      return kind || 'Unbekannt'\n    },\n    formatRelative(iso) {\n      if (!iso) return '-'\n      const ts = Date.parse(iso)\n      if (!isFinite(ts)) return iso\n      const delta = Math.max(0, Math.floor((Date.now() - ts) / 1000))\n      if (delta < 60) return 'vor ' + delta + ' s'\n      if (delta < 3600) return 'vor ' + Math.floor(delta / 60) + ' min'\n      if (delta < 86400) return 'vor ' + Math.floor(delta / 3600) + ' h'\n      return new Date(ts).toLocaleString('de-DE')\n    },\n    reload() {\n      this.send({ payload: { action: 'list' } })\n    },\n    openCreate() {\n      this.form = this.emptyForm()\n      this.errorMsg = ''\n      this.infoMsg = ''\n      this.view = 'form'\n    },\n    openEdit(a) {\n      this.errorMsg = ''\n      this.infoMsg = ''\n      // Payload der Aktion in Formularfelder übersetzen\n      let actionPayload = {}\n      try { actionPayload = JSON.parse(a.action_payload || '{}') } catch(_e) {}\n      this.form = {\n        automation_id: a.automation_id,\n        name: a.name,\n        target_device_id: a.target_device_id,\n        action_kind: a.action_kind,\n        action_relay_1: actionPayload.relay_1 !== undefined ? String(actionPayload.relay_1) : 'true',\n        action_cover_command: actionPayload.command || 'open',\n        enabled: a.enabled === 1 || a.enabled === true,\n        conditions: (a.conditions || []).map(c => this.condFromDb(c))\n      }\n      this.view = 'form'\n      // Bedingungen aus der DB nachladen, falls nur condition_count bekannt\n      if (!a.conditions && a.condition_count > 0) {\n        this.send({ payload: { action: 'load_conditions', automation_id: a.automation_id } })\n      }\n    },\n    condFromDb(c) {\n      let weekdays_arr = []\n      if (c.weekdays) {\n        try {\n          if (c.weekdays.startsWith('[')) weekdays_arr = JSON.parse(c.weekdays)\n          else weekdays_arr = c.weekdays.split(',').map(Number)\n        } catch(_e) {}\n      }\n      return {\n        condition_id: c.condition_id,\n        condition_scope: c.condition_scope,\n        condition_kind: c.condition_kind,\n        weekdays_arr,\n        time_start: c.time_start || '',\n        time_end: c.time_end || '',\n        source_device_id: c.source_device_id || '',\n        field_name: c.field_name || '',\n        operator: c.operator || 'eq',\n        expected_value: c.expected_value !== null && c.expected_value !== undefined ? String(c.expected_value) : ''\n      }\n    },\n    cancelForm() {\n      this.view = 'list'\n      this.form = this.emptyForm()\n    },\n    addCondition() {\n      this.form.conditions.push(this.emptyCondition())\n    },\n    removeCondition(idx) {\n      this.form.conditions.splice(idx, 1)\n    },\n    onActionKindChange() {\n      this.form.action_relay_1 = 'true'\n      this.form.action_cover_command = 'open'\n    },\n    onCondScopeChange(cond) {\n      cond.condition_kind = cond.condition_scope === 'global' ? 'weekdays' : 'device_state'\n    },\n    buildActionPayload() {\n      if (this.form.action_kind === 'net_erl_relay_1') {\n        return { relay_1: this.form.action_relay_1 === 'true' }\n      }\n      if (this.form.action_kind === 'net_zrl_cover') {\n        return { command: this.form.action_cover_command }\n      }\n      return {}\n    },\n    buildConditionPayload(cond) {\n      const out = {\n        condition_scope: cond.condition_scope,\n        condition_kind: cond.condition_kind\n      }\n      if (cond.condition_id) out.condition_id = cond.condition_id\n      if (cond.condition_kind === 'weekdays') {\n        out.weekdays = cond.weekdays_arr.join(',')\n      } else if (cond.condition_kind === 'time_exact') {\n        out.time_start = cond.time_start\n      } else if (cond.condition_kind === 'time_window') {\n        out.time_start = cond.time_start\n        out.time_end = cond.time_end\n      } else if (cond.condition_kind === 'device_state') {\n        out.source_device_id = cond.source_device_id\n        out.field_name = cond.field_name\n        out.operator = cond.operator\n        out.expected_value = cond.expected_value\n      }\n      return out\n    },\n    saveForm() {\n      if (!this.form.name.trim()) { this.errorMsg = 'Name ist erforderlich.'; return }\n      if (!this.form.target_device_id.trim()) { this.errorMsg = 'Zielgerät ist erforderlich.'; return }\n      if (!this.form.action_kind) { this.errorMsg = 'Aktionstyp ist erforderlich.'; return }\n      this.saving = true\n      this.errorMsg = ''\n      this.send({\n        payload: {\n          action: 'save',\n          automation: {\n            automation_id: this.form.automation_id || undefined,\n            name: this.form.name.trim(),\n            target_device_id: this.form.target_device_id.trim(),\n            action_kind: this.form.action_kind,\n            action_payload: this.buildActionPayload(),\n            enabled: this.form.enabled ? 1 : 0\n          },\n          conditions: this.form.conditions.map(c => this.buildConditionPayload(c))\n        }\n      })\n    },\n    toggleEnabled(a) {\n      this.send({ payload: { action: 'toggle_enabled', automation_id: a.automation_id, enabled: a.enabled ? 0 : 1 } })\n    },\n    confirmDelete(a) {\n      this.deleteTarget = a\n    },\n    doDelete() {\n      if (!this.deleteTarget) return\n      this.send({ payload: { action: 'delete', automation_id: this.deleteTarget.automation_id } })\n    },\n    nodeRedRoot() {\n      const path = window.location.pathname\n      const marker = '/dashboard'\n      const index = path.indexOf(marker)\n      return index > 0 ? path.slice(0, index) : ''\n    },\n    loadTheme() {\n      this.isLight = localStorage.getItem('sh-theme') === 'light'\n      this.applyTheme()\n    },\n    toggleTheme() {\n      this.isLight = !this.isLight\n      localStorage.setItem('sh-theme', this.isLight ? 'light' : 'dark')\n      this.applyTheme()\n      window.dispatchEvent(new CustomEvent('sh-theme-change', { detail: { light: this.isLight } }))\n    },\n    applyTheme() {\n      document.documentElement.classList.toggle('sh-light', this.isLight)\n      document.body.classList.toggle('sh-light', this.isLight)\n      if (this.$el) this.$el.classList.toggle('sh-light', this.isLight)\n    },\n    onThemeChange(event) {\n      if (event?.detail && 'light' in event.detail) {\n        this.isLight = event.detail.light\n        this.applyTheme()\n      }\n    }\n  },\n  mounted() {\n    setTimeout(() => this.reload(), 120)\n    this.loadTheme()\n    window.addEventListener('sh-theme-change', this.onThemeChange)\n  },\n  unmounted() {\n    window.removeEventListener('sh-theme-change', this.onThemeChange)\n  }\n}\n</script>\n<style>\n.sh-page{--sh-border:#2a3846;--sh-text:#ecf3fa;--sh-muted:#9db0c3;color:var(--sh-text);padding:.35rem 0 .6rem;width:100%}\n.sh-page *{box-sizing:border-box;min-width:0}\n.sh-toolbar,.sh-toolbar-actions,.sh-chip-stack{display:flex;gap:.45rem;flex-wrap:wrap}\n.sh-toolbar{justify-content:space-between;align-items:flex-start;margin-bottom:.8rem}\n.sh-muted{color:var(--sh-muted)}\n.sh-id{font-size:.8rem;overflow-wrap:anywhere}\n.sh-btn{min-height:44px;border:1px solid var(--sh-border);border-radius:999px;background:linear-gradient(180deg,rgba(22,33,45,.96),rgba(10,17,25,.98));color:var(--sh-text);padding:.62rem .95rem;cursor:pointer;touch-action:manipulation}\n.sh-btn:disabled{opacity:.55;cursor:not-allowed}\n.sh-btn-compact{padding:.5rem .78rem;font-size:.88rem}\n.sh-btn-muted{background:linear-gradient(180deg,rgba(46,56,67,.96),rgba(21,27,33,.98));border-color:rgba(96,112,126,.56)}\n.sh-btn-danger{background:rgba(96,28,40,.86);border-color:rgba(198,92,110,.34);color:#ffd1d7}\n.sh-theme-btn{display:inline-flex;align-items:center;justify-content:center;width:44px;height:44px;border:1px solid var(--sh-border);border-radius:999px;background:linear-gradient(180deg,rgba(22,33,45,.96),rgba(10,17,25,.98));color:var(--sh-text);cursor:pointer;font-size:1.2rem;padding:0}\n.sh-chip{display:inline-flex;align-items:center;border-radius:999px;border:1px solid transparent;background:#182432;color:var(--sh-text);padding:.3rem .6rem;font-size:.82rem}\n.sh-chip-stack{justify-content:flex-end}\n.sh-chip-online{background:rgba(21,78,53,.82);color:#9af3c2;border-color:rgba(86,185,129,.3)}\n.sh-chip-offline{background:rgba(86,28,38,.86);color:#ffb5bf;border-color:rgba(185,89,105,.28)}\n.sh-alert{border-radius:14px;padding:.65rem .8rem;margin-bottom:.75rem}\n.sh-alert-error{background:rgba(96,28,40,.86);border:1px solid rgba(198,92,110,.34);color:#ffd1d7}\n.sh-alert-info{background:rgba(19,60,86,.88);border:1px solid rgba(97,163,214,.34);color:#d0ecff}\n.sh-empty{border:1px solid var(--sh-border);border-radius:18px;background:linear-gradient(180deg,rgba(18,27,38,.97),rgba(11,18,25,.99));padding:.9rem 1rem}\n.sh-auto-list{display:grid;grid-template-columns:repeat(auto-fill,minmax(min(100%,20rem),1fr));gap:.75rem;align-items:start}\n.sh-panel{border:1px solid var(--sh-border);border-radius:18px;background:linear-gradient(180deg,rgba(21,32,43,.98),rgba(11,18,24,.99));padding:.85rem;width:100%}\n.sh-auto-card{border-color:rgba(88,120,170,.45)}\n.sh-form-panel{max-width:50rem;margin:0 auto}\n.sh-card-head{display:flex;justify-content:space-between;gap:.7rem;align-items:flex-start;margin-bottom:.6rem}\n.sh-card-head>div:first-child{min-width:0;flex:1 1 auto}\n.sh-card-head h3{margin:0;overflow-wrap:anywhere}\n.sh-kicker{display:inline-flex;align-items:center;gap:.35rem;font-size:.78rem;text-transform:uppercase;letter-spacing:.08em;color:#a8c4de;margin-bottom:.2rem}\n.sh-state-list{display:grid;gap:.25rem}\n.sh-state-row{display:grid;grid-template-columns:minmax(7rem,auto) minmax(0,1fr);gap:.7rem;border-bottom:1px solid rgba(31,45,58,.9);padding-bottom:.28rem}\n.sh-state-row span,.sh-state-row strong{overflow-wrap:anywhere}\n.sh-state-row strong{text-align:right}\n.sh-val-ok{color:#9af3c2}.sh-val-warn{color:#ffb5bf}\n.sh-auto-actions{display:flex;gap:.45rem;flex-wrap:wrap;margin-top:.75rem;padding-top:.6rem;border-top:1px solid rgba(31,45,58,.9)}\n.sh-form-group{display:grid;gap:.3rem;margin-bottom:.65rem}\n.sh-form-row{display:grid;grid-template-columns:1fr 1fr;gap:.65rem}\n.sh-label{font-size:.82rem;color:var(--sh-muted)}\n.sh-input{width:100%;min-height:44px;border:1px solid rgba(61,83,105,.72);border-radius:12px;background:rgba(10,16,24,.92);color:var(--sh-text);padding:.55rem .75rem}\n.sh-divider{border:0;border-top:1px solid var(--sh-border);margin:1rem 0}\n.sh-conditions-list{display:grid;gap:.6rem}\n.sh-condition-block{border:1px solid rgba(61,83,105,.55);border-radius:14px;padding:.7rem}\n.sh-condition-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:.55rem}\n.sh-weekday-row{display:flex;gap:.45rem;flex-wrap:wrap;margin-top:.3rem}\n.sh-weekday-label{display:flex;align-items:center;gap:.25rem;font-size:.88rem;cursor:pointer}\n.sh-form-actions{display:flex;gap:.55rem;flex-wrap:wrap;margin-top:1rem;padding-top:.75rem;border-top:1px solid var(--sh-border)}\n.sh-overlay{position:fixed;inset:0;background:rgba(0,0,0,.65);display:flex;align-items:center;justify-content:center;z-index:9999}\n.sh-modal{background:#111821;border:1px solid var(--sh-border);border-radius:20px;padding:1.2rem;max-width:28rem;width:90%}\n.sh-modal h3{margin:0 0 .6rem}\n.sh-modal p{color:var(--sh-muted);margin:.4rem 0 1rem}\n.sh-modal-actions{display:flex;gap:.5rem;flex-wrap:wrap}\n.sh-page.sh-light{--sh-border:#d0d7e2;--sh-text:#1a2332;--sh-muted:#687690;color:var(--sh-text)}\n.sh-page.sh-light .sh-panel{background:#fff;border-color:#dde3ec}\n.sh-page.sh-light .sh-auto-card{border-color:rgba(68,108,160,.35)}\n.sh-page.sh-light .sh-empty{background:#fff;border-color:#dde3ec}\n.sh-page.sh-light .sh-btn{background:#36c6aa;border-color:#36c6aa;color:#fff;font-weight:600}\n.sh-page.sh-light .sh-btn-muted{background:#e8ecf1;border-color:#c8d0dc;color:#3a4a5c}\n.sh-page.sh-light .sh-btn-danger{background:#fde4e8;border-color:rgba(175,79,95,.4);color:#8c1f2e}\n.sh-page.sh-light .sh-theme-btn{background:#fff;border-color:#c8d0dc;color:#1a2332}\n.sh-page.sh-light .sh-chip-online{background:#d4f5e2;color:#0d5c2e}\n.sh-page.sh-light .sh-chip-offline{background:#fde4e8;color:#8c1f2e}\n.sh-page.sh-light .sh-input{background:#fff;border-color:#c8d0dc;color:#1a2332}\n.sh-page.sh-light .sh-state-row{border-bottom-color:#e4e9f0}\n.sh-page.sh-light .sh-auto-actions{border-top-color:#e4e9f0}\n.sh-page.sh-light .sh-condition-block{border-color:#c8d0dc}\n.sh-page.sh-light .sh-form-actions{border-top-color:#e4e9f0}\n.sh-page.sh-light .sh-modal{background:#fff;border-color:#dde3ec}\n.sh-page.sh-light .sh-val-ok{color:#0d5c2e}.sh-page.sh-light .sh-val-warn{color:#8c1f2e}\n.sh-page.sh-light .sh-alert-error{background:#fde4e8;border:1px solid rgba(198,92,110,.34);color:#8c1f2e}\n.sh-page.sh-light .sh-alert-info{background:#d8eefc;border:1px solid rgba(87,153,204,.34);color:#1a4a6e}\n.sh-page.sh-light .sh-kicker{color:#4a6a8e}.sh-page.sh-light .sh-muted{color:#687690}\n@media (max-width:640px){.sh-toolbar{flex-direction:column;align-items:stretch}.sh-toolbar-actions{width:100%}.sh-auto-list{grid-template-columns:1fr}.sh-form-row{grid-template-columns:1fr}}\n</style>",
