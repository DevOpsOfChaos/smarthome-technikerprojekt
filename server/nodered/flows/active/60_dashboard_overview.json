[
  {
    "id": "tab_dashboard_v1_ui",
    "type": "tab",
    "label": "60 Dashboard Overview",
    "disabled": false,
    "info": "Kleine Dashboard-V1-Übersicht auf Basis der aktuellen Phase-1-Tabellen."
  },
  {
    "id": "ui_template_dashboard_overview_v1",
    "type": "ui-template",
    "z": "tab_dashboard_v1_ui",
    "group": "cfg_ui_group_overview_v1",
    "name": "Overview View",
    "order": 1,
    "width": 12,
    "height": 0,
    "format": "<template>\n  <div class=\"sh-page\">\n    <div class=\"sh-toolbar\">\n      <div class=\"sh-toolbar-summary\" v-if=\"payload.summary\">\n        <span class=\"sh-chip\">{{ payload.summary.device_count || 0 }} Geräte</span>\n        <span class=\"sh-chip\">{{ payload.summary.master_count || 0 }} Master</span>\n      </div>\n      <button class=\"sh-btn\" @click=\"reload\">Neu laden</button>\n    </div>\n\n    <div v-if=\"commandError\" class=\"sh-alert sh-alert-error\">{{ commandError }}</div>\n\n    <div class=\"sh-empty\" v-if=\"!devices.length\">Noch keine Geräte in `devices` sichtbar.</div>\n\n    <div class=\"sh-grid\" v-else>\n      <article\n        v-for=\"device in devices\"\n        :key=\"device.device_id\"\n        class=\"sh-card\"\n        :class=\"[\n          device.surface_class,\n          {\n            'sh-card--navigable': !isLampToggleDevice(device),\n            'sh-card--busy': isPending(device.device_id),\n            'sh-card--toggle': isLampToggleDevice(device)\n          }\n        ]\"\n        :tabindex=\"isLampToggleDevice(device) ? null : 0\"\n        @click=\"handleCardClick(device)\"\n        @keydown.enter.prevent=\"handleCardClick(device)\"\n        @keydown.space.prevent=\"handleCardClick(device)\">\n        <div class=\"sh-card-head\">\n          <div>\n            <span class=\"sh-kicker\"><i :class=\"'mdi ' + device.type_icon\"></i>{{ device.kind_label }}</span>\n            <h3>{{ device.display_name }}</h3>\n            <p class=\"sh-muted sh-id\">{{ device.device_id }}</p>\n          </div>\n          <div class=\"sh-chip-stack\">\n            <span class=\"sh-chip\" :class=\"device.availability_class\">{{ device.availability_label }}</span>\n            <span class=\"sh-chip sh-chip-sim\" v-if=\"device.simulation\">SIM</span>\n          </div>\n        </div>\n\n        <button\n          v-if=\"isLampToggleDevice(device)\"\n          type=\"button\"\n          class=\"sh-lamp-surface\"\n          :class=\"{ 'is-on': device.controls.relay_1_value === true }\"\n          :disabled=\"isPending(device.device_id)\"\n          @click.stop=\"toggleLamp(device)\">\n          <span class=\"sh-lamp-icon\">\n            <i :class=\"device.controls.relay_1_value === true ? 'mdi mdi-lightbulb-on' : 'mdi mdi-lightbulb-outline'\"></i>\n          </span>\n          <span class=\"sh-lamp-copy\">\n            <strong>Lampe {{ relayStateLabel(device) }}</strong>\n          </span>\n        </button>\n\n        <div class=\"sh-highlight-grid\" v-if=\"device.highlight_values && device.highlight_values.length\">\n          <div class=\"sh-highlight\" v-for=\"item in device.highlight_values\" :key=\"device.device_id + '-' + item.key\">\n            <span>{{ item.label }}</span>\n            <strong>{{ item.value_text }}</strong>\n          </div>\n        </div>\n\n        <div class=\"sh-inline-row\" v-if=\"!isLampToggleDevice(device) && device.controls && device.controls.kind === 'relay'\">\n          <span class=\"sh-secondary-pill\" v-for=\"relay in device.controls.relays\" :key=\"device.device_id + '-' + relay.key\">{{ relay.label }}: {{ relay.state_label }}</span>\n        </div>\n\n        <div class=\"sh-inline-row\" v-if=\"device.controls && device.controls.kind === 'cover'\">\n          <span class=\"sh-secondary-pill\">Position: {{ device.controls.position_text }}</span>\n        </div>\n\n        <div class=\"sh-cover-compact\" v-if=\"isCoverControlDevice(device)\">\n          <p class=\"sh-cover-motion\">Bewegung: {{ device.controls.state_text }}</p>\n          <div class=\"sh-cover-command-row\">\n            <button class=\"sh-btn sh-btn-wide\" :disabled=\"isPending(device.device_id)\" @click.stop=\"sendCoverCommand(device, 'open')\">Auf</button>\n            <button class=\"sh-btn sh-btn-wide\" :disabled=\"isPending(device.device_id)\" @click.stop=\"sendCoverCommand(device, 'stop')\">Stop</button>\n            <button class=\"sh-btn sh-btn-wide\" :disabled=\"isPending(device.device_id)\" @click.stop=\"sendCoverCommand(device, 'close')\">Ab</button>\n          </div>\n          <div class=\"sh-cover-end-row\">\n            <button class=\"sh-quick-btn\" :disabled=\"isPending(device.device_id) || !device.controls.allow_end_positions\" @click.stop=\"sendCoverPosition(device, 0)\">0</button>\n            <button class=\"sh-quick-btn\" :disabled=\"isPending(device.device_id) || !device.controls.allow_end_positions\" @click.stop=\"sendCoverPosition(device, 100)\">100</button>\n          </div>\n          <p class=\"sh-cover-calibration\" v-if=\"device.controls.calibration_hint_text\">{{ device.controls.calibration_hint_text }}</p>\n        </div>\n\n        <div class=\"sh-inline-row\" v-if=\"device.battery_value\">\n          <span class=\"sh-secondary-pill\">{{ device.battery_value }}</span>\n        </div>\n\n        <div class=\"sh-footer\">\n          <span class=\"sh-muted\" :title=\"device.status_time_exact_label\">{{ device.status_time_label }}: {{ device.status_time_value }}</span>\n          <button type=\"button\" class=\"sh-detail-link\" @click.stop=\"openDetail(device)\">Detail</button>\n        </div>\n      </article>\n    </div>\n  </div>\n</template>\n<script>\nexport default {\n  data() {\n    return {\n      pendingDeviceIds: {},\n      commandError: '',\n      autoRefreshTimer: null,\n      autoRefreshMs: 5000\n    }\n  },\n  computed: {\n    payload() { return this.msg?.payload || { summary: {}, devices: [] } },\n    devices() { return Array.isArray(this.payload.devices) ? this.payload.devices : [] }\n  },\n  methods: {\n    reload() {\n      this.send({ payload: { action: 'load' } })\n    },\n    shouldSkipAutoRefresh() {\n      return document.hidden || Object.keys(this.pendingDeviceIds).length > 0\n    },\n    startAutoRefresh() {\n      this.stopAutoRefresh()\n\n      // Lokale Geräteaktionen landen serverseitig bereits in `device_state_latest`, bleiben im V1-Dashboard ohne neuen Load aber unsichtbar.\n      // Die Übersicht zieht deshalb denselben kleinen Load-Pfad in ruhigem Intervall nach, statt hier eine größere Live-Event-Architektur einzubauen.\n      this.autoRefreshTimer = window.setInterval(() => {\n        if (this.shouldSkipAutoRefresh()) {\n          return\n        }\n        this.reload()\n      }, this.autoRefreshMs)\n    },\n    stopAutoRefresh() {\n      if (this.autoRefreshTimer) {\n        window.clearInterval(this.autoRefreshTimer)\n        this.autoRefreshTimer = null\n      }\n    },\n    handleVisibilityChange() {\n      if (!this.shouldSkipAutoRefresh()) {\n        this.reload()\n      }\n    },\n    isLampToggleDevice(device) {\n      return Boolean(device?.controls?.allow_overview_toggle)\n    },\n    isCoverControlDevice(device) {\n      return Boolean(device?.controls?.allow_overview_controls)\n    },\n    canAdjustIntermediate(controls) {\n      return Boolean(controls?.allow_intermediate_positions)\n    },\n    isPending(deviceId) {\n      return Boolean(this.pendingDeviceIds[deviceId])\n    },\n    setPending(deviceId, pending) {\n      const nextPendingDeviceIds = Object.assign({}, this.pendingDeviceIds)\n      if (pending) {\n        nextPendingDeviceIds[deviceId] = true\n      } else {\n        delete nextPendingDeviceIds[deviceId]\n      }\n      this.pendingDeviceIds = nextPendingDeviceIds\n    },\n    relayStateLabel(device) {\n      return device?.controls?.relay_1_value === true ? 'An' : 'Aus'\n    },\n    openDetail(device) {\n      if (device?.detail_url) {\n        window.location.assign(device.detail_url)\n      }\n    },\n    handleCardClick(device) {\n      if (!this.isLampToggleDevice(device)) {\n        this.openDetail(device)\n      }\n    },\n    async postJson(url, payload) {\n      const response = await fetch(url, {\n        method: 'POST',\n        headers: { 'Content-Type': 'application/json' },\n        body: JSON.stringify(payload)\n      })\n      const body = await response.json().catch(() => null)\n      if (!response.ok) {\n        throw new Error(body?.message || body?.error || `HTTP ${response.status}`)\n      }\n      return body\n    },\n    async toggleLamp(device) {\n      if (!this.isLampToggleDevice(device) || this.isPending(device.device_id)) {\n        return\n      }\n\n      this.setPending(device.device_id, true)\n      this.commandError = ''\n\n      try {\n        // Das Backend erwartet hier keinen Toggle-Befehl. Die UI leitet deshalb den nächsten expliziten relay_1-Wert aus dem Live-Status ab.\n        const nextRelayValue = !(device.controls.relay_1_value === true)\n        await this.postJson(device.controls.command_url || '/api/phase1/net-erl/relay-1', {\n          device_id: device.device_id,\n          relay_1: nextRelayValue\n        })\n        window.setTimeout(() => this.reload(), 250)\n      } catch (error) {\n        this.commandError = error?.message || 'Lampenbefehl fehlgeschlagen.'\n      } finally {\n        this.setPending(device.device_id, false)\n      }\n    },\n    async sendCoverCommand(device, command, extraPayload = {}) {\n      const controls = device?.controls\n      if (!this.isCoverControlDevice(device) || !controls || this.isPending(device.device_id)) {\n        return\n      }\n\n      this.setPending(device.device_id, true)\n      this.commandError = ''\n\n      try {\n        // Die Übersicht bleibt absichtlich kompakt: Richtungsbefehle und sichere Endlagen direkt hier, feinere Positionswahl nur auf der Detailseite.\n        await this.postJson(controls.command_url || '/api/phase1/cover/command', Object.assign({\n          device_id: device.device_id,\n          command,\n          cover_calibrated: Boolean(controls.position_calibrated),\n          is_calibrated: Boolean(controls.position_calibrated)\n        }, extraPayload))\n        window.setTimeout(() => this.reload(), 250)\n      } catch (error) {\n        this.commandError = error?.message || 'Rollladenbefehl fehlgeschlagen.'\n      } finally {\n        this.setPending(device.device_id, false)\n      }\n    },\n    async sendCoverPosition(device, position) {\n      const controls = device?.controls\n      if (!controls || !controls.allow_end_positions || ![0, 100].includes(position) || this.isPending(device?.device_id)) {\n        return\n      }\n\n      // Ohne Kalibrierung werden in der Übersicht nur die belastbaren Endlagen angeboten. Zwischenwerte bleiben bewusst in der Detailseite gesperrt oder kalibrierungsabhängig.\n      await this.sendCoverCommand(device, 'set_position', { position })\n    }\n  },\n  mounted() {\n    setTimeout(() => this.reload(), 120)\n    this.startAutoRefresh()\n    document.addEventListener('visibilitychange', this.handleVisibilityChange)\n  },\n  unmounted() {\n    this.stopAutoRefresh()\n    document.removeEventListener('visibilitychange', this.handleVisibilityChange)\n  }\n}\n</script>\n<style>\n  .sh-page{--sh-border:#2a3846;--sh-text:#ecf3fa;--sh-muted:#9db0c3;--sh-chip:#182432;color:var(--sh-text);padding:.35rem 0 .6rem}.sh-page *{box-sizing:border-box}.sh-toolbar,.sh-toolbar-summary,.sh-inline-row,.sh-chip-stack{display:flex;gap:.45rem;flex-wrap:wrap}.sh-toolbar{justify-content:space-between;align-items:center;margin-bottom:.8rem}.sh-card h3{margin:0}.sh-muted{color:var(--sh-muted);margin:.15rem 0 0}.sh-btn,.sh-detail-link{border:1px solid var(--sh-border);border-radius:999px;background:linear-gradient(180deg,rgba(22,33,45,.96),rgba(10,17,25,.98));color:var(--sh-text);padding:.55rem .9rem;cursor:pointer}.sh-btn:disabled,.sh-quick-btn:disabled{cursor:not-allowed;opacity:.55}.sh-btn-wide{width:100%}.sh-detail-link{padding:.38rem .72rem;font-size:.8rem}.sh-chip,.sh-secondary-pill{display:inline-flex;align-items:center;gap:.25rem;border-radius:999px;border:1px solid transparent;background:var(--sh-chip);color:var(--sh-text);padding:.3rem .6rem;font-size:.82rem}.sh-secondary-pill{background:rgba(24,36,50,.88);border-color:rgba(61,83,105,.72)}.sh-secondary-pill.is-state-ready{border-color:rgba(84,184,129,.42);color:#b6f1cb}.sh-secondary-pill.is-state-limited{border-color:rgba(204,152,76,.42);color:#ffd897}.sh-chip-online{background:rgba(21,78,53,.82);color:#9af3c2;border-color:rgba(86,185,129,.3)}.sh-chip-late{background:rgba(77,64,23,.88);color:#ffdd8b;border-color:rgba(177,145,63,.3)}.sh-chip-offline{background:rgba(86,28,38,.86);color:#ffb5bf;border-color:rgba(185,89,105,.28)}.sh-chip-unknown{background:#232e39;color:#b6c2cc}.sh-chip-sim{background:rgba(66,50,19,.88);color:#ffd98a}.sh-alert{border-radius:14px;padding:.65rem .8rem;margin-bottom:.75rem}.sh-alert-error{background:rgba(96,28,40,.86);border:1px solid rgba(198,92,110,.34);color:#ffd1d7}.sh-empty{border:1px solid var(--sh-border);border-radius:18px;background:linear-gradient(180deg,rgba(18,27,38,.97),rgba(11,18,25,.99));padding:.9rem 1rem}.sh-grid{column-width:260px;column-gap:.75rem}.sh-card{width:100%;margin:0 0 .75rem;border:1px solid var(--sh-border);border-radius:20px;background:radial-gradient(circle at top right,rgba(123,200,255,.11),transparent 36%),linear-gradient(180deg,rgba(21,32,43,.98),rgba(11,18,24,.99));padding:.85rem;display:inline-grid;gap:.7rem;min-height:0;break-inside:avoid;page-break-inside:avoid}.sh-card--navigable{cursor:pointer}.sh-card--navigable:focus-visible{outline:2px solid rgba(123,200,255,.78);outline-offset:2px}.sh-card--busy{opacity:.78}.sh-card.is-relay-card{border-color:rgba(171,139,67,.55)}.sh-card.is-cover-card{border-color:rgba(99,168,207,.55)}.sh-card.is-battery-card{border-color:rgba(75,143,89,.55)}.sh-card-head,.sh-footer{display:flex;justify-content:space-between;gap:.7rem;align-items:flex-start}.sh-kicker{display:inline-flex;align-items:center;gap:.35rem;font-size:.78rem;text-transform:uppercase;letter-spacing:.08em;color:#a8c4de;margin-bottom:.2rem}.sh-id{font-size:.8rem}.sh-highlight-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(98px,1fr));gap:.42rem}.sh-highlight{border:1px solid rgba(45,65,84,.8);border-radius:14px;padding:.5rem .55rem;background:rgba(9,16,23,.45)}.sh-highlight span{display:block;font-size:.72rem;color:var(--sh-muted);margin-bottom:.12rem}.sh-highlight strong{font-size:.96rem}.sh-lamp-surface{display:flex;align-items:center;gap:.9rem;width:100%;border:1px solid rgba(119,132,145,.38);border-radius:18px;padding:.85rem .95rem;background:linear-gradient(180deg,rgba(57,66,76,.92),rgba(24,30,36,.98));color:var(--sh-text);cursor:pointer;text-align:left;transition:transform .12s ease,border-color .12s ease,box-shadow .12s ease}.sh-lamp-surface:hover:not(:disabled),.sh-lamp-surface:focus-visible{transform:translateY(-1px);border-color:rgba(173,185,197,.66);box-shadow:0 0 0 1px rgba(173,185,197,.18)}.sh-lamp-surface:disabled{cursor:wait;opacity:.78}.sh-lamp-surface.is-on{background:radial-gradient(circle at top,rgba(255,224,140,.28),transparent 38%),linear-gradient(180deg,rgba(123,95,27,.88),rgba(46,34,13,.96));border-color:rgba(255,219,118,.54)}.sh-lamp-icon{display:grid;place-items:center;width:3.1rem;height:3.1rem;border-radius:16px;background:rgba(12,18,25,.42);font-size:1.55rem;color:#c7d0d8}.sh-lamp-surface.is-on .sh-lamp-icon{color:#ffe192}.sh-lamp-copy{display:grid;gap:.14rem;justify-items:center;width:100%}.sh-lamp-copy strong{font-size:1rem;text-align:center}.sh-cover-compact{display:grid;gap:.45rem;justify-items:center}.sh-cover-motion{margin:0;text-align:center;font-size:.88rem;font-weight:600}.sh-cover-command-row{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.42rem;width:min(100%,17rem)}.sh-cover-end-row{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.42rem;width:min(100%,11rem)}.sh-cover-calibration{margin:0;font-size:.8rem;color:#ffd897;text-align:center}.sh-quick-btn{border:1px solid rgba(61,83,105,.72);border-radius:14px;background:rgba(15,24,34,.94);color:var(--sh-text);padding:.6rem .2rem;cursor:pointer}.sh-quick-btn:not(:disabled):hover,.sh-quick-btn:not(:disabled):focus-visible{border-color:rgba(123,200,255,.6);background:rgba(23,38,52,.96)}.sh-footer{margin-top:auto;padding-top:.7rem;border-top:1px solid rgba(31,45,58,.9);align-items:center}.sh-detail-link{margin-left:auto}.sh-card--toggle .sh-footer{padding-top:.6rem}@media (max-width:640px){.sh-grid{column-width:auto}.sh-toolbar,.sh-card-head,.sh-footer{flex-direction:column;align-items:flex-start}.sh-detail-link{margin-left:0}.sh-lamp-surface{padding:.8rem}.sh-cover-command-row,.sh-cover-end-row{grid-template-columns:1fr;width:100%}}\n</style>",
    "storeOutMessages": true,
    "passthru": false,
    "resendOnRefresh": true,
    "templateScope": "local",
    "className": "",
    "x": 220,
    "y": 140,
    "wires": [
