  {
    "id": "fn_build_dashboard_overview_query_v1",
    "type": "function",
    "z": "tab_dashboard_v1_ui",
    "name": "Build Dashboard Query",
    "func": "const dashboard = global.get(\"dashboardV1\");\nif (!dashboard) {\n    node.error(\"dashboardV1 helper missing\");\n    return null;\n}\nmsg.topic = dashboard.buildOverviewQuery();\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 480,
    "y": 140,
    "wires": [
      [
        "sqlite_dashboard_overview_v1"
      ]
    ]
  },
  {
    "id": "sqlite_dashboard_overview_v1",
    "type": "sqlite",
    "z": "tab_dashboard_v1_ui",
    "mydb": "sqlitedb_30_phase1",
    "sqlquery": "msg.topic",
    "sql": "",
    "name": "Read Overview",
    "x": 700,
    "y": 140,
    "wires": [
      [
        "fn_build_dashboard_overview_payload_v1"
      ]
    ]
  },
  {
    "id": "fn_build_dashboard_overview_payload_v1",
    "type": "function",
    "z": "tab_dashboard_v1_ui",
    "name": "Build Overview Payload",
    "func": "const dashboard = global.get(\"dashboardV1\");\nif (!dashboard) {\n    node.error(\"dashboardV1 helper missing\");\n    return null;\n}\nmsg.payload = dashboard.buildOverviewPayload(Array.isArray(msg.payload) ? msg.payload : []);\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
