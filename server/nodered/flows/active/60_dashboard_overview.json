  {
    "id": "fn_build_dashboard_overview_payload_v1",
    "type": "function",
    "z": "tab_dashboard_v1_ui",
    "name": "Build Overview Payload",
    "func": "const dashboard = global.get(\"dashboardV1\");\nif (!dashboard) {\n    node.error(\"dashboardV1 helper missing\");\n    return null;\n}\nmsg.payload = dashboard.buildOverviewPayload(Array.isArray(msg.payload) ? msg.payload : []);\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
