[
  {
    "id": "tab_10_ingest",
    "type": "tab",
    "label": "10_mqtt_ingest",
    "disabled": false,
    "info": "Abonniert die relevanten MQTT-Themen und verteilt sie an kleine Handler."
  },
  {
    "id": "comment_10_ingest",
    "type": "comment",
    "z": "tab_10_ingest",
    "name": "MQTT Ingest",
    "info": "Der aktuelle Server verarbeitet meta, availability, state, event, ack sowie master status/event. Topic-Erkennung liegt zentral in /data/lib/topic_router.js.",
    "x": 150,
    "y": 60,
    "wires": []
  },
  {
    "id": "cfg_mqtt_broker",
    "type": "mqtt-broker",
    "name": "local mqtt",
    "broker": "mosquitto",
    "port": "1883",
    "clientid": "nodered-phase1",
    "autoConnect": true,
    "usetls": false,
    "protocolVersion": "4",
    "keepalive": "60",
    "cleansession": true,
    "birthTopic": "",
    "birthQos": "0",
    "birthRetain": "false",
    "birthPayload": "",
    "birthMsg": {},
    "closeTopic": "",
    "closeQos": "0",
    "closeRetain": "false",
    "closePayload": "",
    "closeMsg": {},
    "willTopic": "",
    "willQos": "0",
    "willRetain": "false",
    "willPayload": "",
    "willMsg": {},
    "userProps": "",
    "sessionExpiry": ""
  },
  {
    "id": "mqtt_10_device_in",
    "type": "mqtt in",
    "z": "tab_10_ingest",
    "name": "Device topics",
    "topic": "smarthome/device/+/+",
    "qos": "0",
    "datatype": "auto-detect",
    "broker": "cfg_mqtt_broker",
    "nl": false,
    "rap": true,
    "rh": 0,
    "inputs": 0,
    "x": 150,
    "y": 140,
    "wires": [
      [
        "json_10_device"
      ]
    ]
  },
  {
    "id": "json_10_device",
    "type": "json",
    "z": "tab_10_ingest",
    "name": "Device JSON",
    "property": "payload",
    "action": "",
    "pretty": false,
    "x": 350,
    "y": 140,
    "wires": [
      [
        "func_10_device_route"
      ]
    ]
  },
  {
    "id": "func_10_device_route",
    "type": "function",
    "z": "tab_10_ingest",
    "name": "Route device topic",
    "func": "const topicRouter = global.get(\"topicRouter\");\nconst timeHelpers = global.get(\"timeHelpers\");\nconst routed = topicRouter.buildRoutingState(msg.topic, timeHelpers.nowIso());\nif (!routed || routed.scope !== \"device\") {\n    return null;\n}\nif (msg.payload === undefined || msg.payload === null) {\n    msg.payload = {};\n}\nmsg.sh = routed;\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 580,
    "y": 140,
    "wires": [
      [
        "switch_10_device"
      ]
    ]
  },
  {
    "id": "switch_10_device",
    "type": "switch",
    "z": "tab_10_ingest",
    "name": "Device topic type",
    "property": "sh.topic_type",
    "propertyType": "msg",
    "rules": [
      {
        "t": "eq",
        "v": "meta",
        "vt": "str"
      },
      {
        "t": "eq",
        "v": "availability",
        "vt": "str"
      },
      {
        "t": "eq",
        "v": "state",
        "vt": "str"
      },
      {
        "t": "eq",
        "v": "event",
        "vt": "str"
      },
      {
        "t": "eq",
        "v": "ack",
        "vt": "str"
      }
    ],
    "checkall": "true",
    "repair": false,
    "outputs": 5,
    "x": 810,
    "y": 140,
    "wires": [
      [
        "linkout_10_meta"
      ],
      [
        "linkout_10_availability"
      ],
      [
        "linkout_10_state"
      ],
      [
        "linkout_10_event"
      ],
      [
        "linkout_10_ack"
      ]
    ]
  },
