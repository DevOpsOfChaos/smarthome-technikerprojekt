  {
    "id": "func_10_master_route",
    "type": "function",
    "z": "tab_10_ingest",
    "name": "Route master topic",
    "func": "const topicRouter = global.get(\"topicRouter\");\nconst timeHelpers = global.get(\"timeHelpers\");\nconst routed = topicRouter.buildRoutingState(msg.topic, timeHelpers.nowIso());\nif (!routed || routed.scope !== \"master\") {\n    return null;\n}\nif (msg.payload === undefined || msg.payload === null) {\n    msg.payload = {};\n}\nmsg.sh = routed;\nreturn msg;",
